        <mxCell id="node_pinit" parent="g1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0369a1;align=center;shadow=1;" value="Mô hình Hiện hành (Teacher v_{t-1})&#xa;P_init = f_theta_teacher(X_new)&#xa;Dự đoán ban đầu bác sĩ nhìn thấy" vertex="1">
          <mxGeometry height="65" width="230" x="40" y="45" as="geometry" />
