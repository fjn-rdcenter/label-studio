        <mxCell id="node_expert" parent="g1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#15803d;align=center;shadow=1;" value="Nhãn Hiệu chỉnh Chuẩn Y_new&#xa;Bác sĩ / Chuyên gia phôi sửa lỗi:&#xa;Vùng ZP, TE (Ring) + ICM, BC (Polygon)" vertex="1">
          <mxGeometry height="65" width="230" x="315" y="45" as="geometry" />
        </mxCell>
        <mxCell id="node_diff" parent="g1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#92400e;align=center;shadow=1;" value="Phân Tích Lỗi Không Gian (Spatial Error)&#xa;M_error(i,j) = [P_init(i,j) != Y_new(i,j)]&#xa;Xác định chính xác từng pixel bác sĩ đã sửa" vertex="1">
          <mxGeometry height="65" width="230" x="590" y="45" as="geometry" />
        </mxCell>
        <mxCell id="eg1_2" edge="1" parent="g1" source="node_expert" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#16a34a;strokeWidth=2;" target="node_diff">
