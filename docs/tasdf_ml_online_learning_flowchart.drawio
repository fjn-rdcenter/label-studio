        <mxCell id="g2" parent="1" style="swimlane;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#475569;startSize=26;" value="GIAI ĐOẠN 2: THIẾT KẾ LOSS TRỌNG SỐ &amp; BỘ NHỚ TRẢI NGHIỆM (REPLAY / ANCHOR)" vertex="1">
          <mxGeometry height="155" width="860" x="60" y="310" as="geometry" />
