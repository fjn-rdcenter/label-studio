    <mxCell id="e8_fail" value="KHÔNG ĐẠT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#ef4444;strokeWidth=2;fontSize=10;fontColor=#dc2626;fontStyle=1;" edge="1" source="step8" target="step9A" parent="1">
      <mxGeometry relative="1" as="geometry"/>
