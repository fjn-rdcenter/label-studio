    <mxCell id="e_loop" value="Vòng lặp kín: Cung cấp dự đoán mới cho các ca gán nhãn tiếp theo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#059669;strokeWidth=2;dashed=1;fontSize=10;fontColor=#047857;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="step11" target="step1" parent="1">
