@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-Regular.ttf") format("truetype");
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-SemiBold.ttf") format("truetype");
  font-weight: 500;
  font-style: normal;
  font-display: swap;
}
body {
  font-family: 'Figtree', sans-serif !important;
  --sand_900: #12110d;
  --sand_800: #262522;
  --sand_700: #45433e;
  --sand_600: #6b6860;
  --sand_500: #a49f95;
  --sand_400: #cac5b8;
  --sand_300: #e1ded5;
  --sand_200: #f0efeb;
  --sand_100: #f9f8f6;
  --sand_0: #fdfdfc;
  --grape_0: #f0f3fe;
  --grape_100: #d4dbfb;
  --grape_500: #566fcf;
  --grape_600: #576cc1;
  --grape_700: #4c5fa9;
  --grape_800: #37447a;
  --kale_0: #f4f9f9;
  --kale_400: #57b7ab;
  --plum_500: #cc6fbe;
  --plum_400: #e37bd3;
  --plum_100: #f7d6f2;
  --plum_0: #fbf2fc;
  --persimmon_300: #ff9f89;
  --persimmon_400: #ff7557;
  --canteloupe_0: #fff6ef;
  --canteloupe_100: #ffe4d0;
  --canteloupe_400: #ffa663;
  --canteloupe_500: #e69559;
  --canteloupe_600: #cc854f;
  --canteloupe_700: #b37445;
  --red_1: #fff1f0;
  --red_3: #ffccc7;
  --red_7: #cf1322;
  --red_10: #5c0011;
  --primary_link: #566fcf;
  --danger_color: var(--red_7);
}
.label {
  margin-bottom: 0;
}
.label__text {
  height: 22px;
  display: flex;
  margin-bottom: 0;
  font-size: 14px;
  line-height: 120%;
}
.label__description {
  font-size: 0.875rem;
  color: var(--sand_600);
  font-weight: 400;
  line-height: 140%;
}
.label__description a {
  color: var(--grape_500);
  text-decoration: underline;
}
.label__description a:hover {
  text-decoration: none;
}
.label__field {
  line-height: 0;
}
.label__label {
  display: flex;
  align-items: center;
}
.label_size_large .label__text {
  font-weight: 500;
  font-size: 0.875rem;
}
.label_flat .label__text {
  padding: 0;
}
.label .input,
.label .select,
.label .textarea {
  width: 100%;
}
.label[data-required] .label__text::after {
  content: "Required";
  font-size: 0.825rem;
  color: var(--sand_500);
  margin-left: 0.325rem;
}
.label_large .label__text {
  font-size: 1.25rem;
  font-weight: 500;
}
.label_placement_right,
.label_placement_left {
  display: grid;
  gap: 8px;
  row-gap: 0;
}
.label_placement_right {
  grid-template-areas: "field label" "field description";
  grid-template-columns: auto 1fr;
}
.label_placement_left {
  grid-template-areas: "label field" "description field";
  grid-template-columns: 1fr auto;
}
.label_placement_left:not(.label_withDescription) {
  grid-template-areas: "label field";
}
.label_placement_right:not(.label_withDescription) {
  grid-template-areas: "field label";
}
.label_empty .label__text,
.label_placement_right .label__text,
.label_placement_left .label__text {
  grid-area: label;
  margin-bottom: 0;
  line-height: 22px;
  height: auto;
  align-items: center;
  font-weight: 500;
}
.label_placement_right:not(.label_withDescription) .label__field,
.label_placement_left:not(.label_withDescription) .label__field {
  grid-area: field;
  display: flex;
  align-items: center;
}
.label_placement_right .label__description,
.label_placement_left .label__description {
  grid-area: description;
}
.label_placement_right.label_withDescription .label__field input[type="radio"] {
  margin: 4px 0 0 0;
}
label {
  font-weight: 500;
  font-size: 0.875rem;
  margin-bottom: 4px;
  display: block;
}
