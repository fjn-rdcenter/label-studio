@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-Regular.ttf") format("truetype");
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-SemiBold.ttf") format("truetype");
  font-weight: 500;
  font-style: normal;
  font-display: swap;
}
body {
  font-family: 'Figtree', sans-serif !important;
  --sand_900: #12110d;
  --sand_800: #262522;
  --sand_700: #45433e;
  --sand_600: #6b6860;
  --sand_500: #a49f95;
  --sand_400: #cac5b8;
  --sand_300: #e1ded5;
  --sand_200: #f0efeb;
  --sand_100: #f9f8f6;
  --sand_0: #fdfdfc;
  --grape_0: #f0f3fe;
  --grape_100: #d4dbfb;
  --grape_500: #566fcf;
  --grape_600: #576cc1;
  --grape_700: #4c5fa9;
  --grape_800: #37447a;
  --kale_0: #f4f9f9;
  --kale_400: #57b7ab;
  --plum_500: #cc6fbe;
  --plum_400: #e37bd3;
  --plum_100: #f7d6f2;
  --plum_0: #fbf2fc;
  --persimmon_300: #ff9f89;
  --persimmon_400: #ff7557;
  --canteloupe_0: #fff6ef;
  --canteloupe_100: #ffe4d0;
  --canteloupe_400: #ffa663;
  --canteloupe_500: #e69559;
  --canteloupe_600: #cc854f;
  --canteloupe_700: #b37445;
  --red_1: #fff1f0;
  --red_3: #ffccc7;
  --red_7: #cf1322;
  --red_10: #5c0011;
  --primary_link: #566fcf;
  --danger_color: var(--red_7);
}
.webhook-wrap {
  flex: 1;
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: space-between;
  flex-direction: column;
  width: 42rem;
}
.webhook-wrap h1 {
  margin-bottom: 0.5rem;
}
.webhook-wrap__content {
  flex: 1;
  margin: 2rem;
  width: 42rem;
}
.webhook-wrap__footer {
  box-sizing: content-box !important;
  flex: none;
  width: 100%;
  height: 88px;
  background: var(--sand_100);
  border: 1px var(--sand_300) solid;
  margin-left: -2px;
  display: flex;
  align-items: top;
  padding-top: 24px;
}
.webhook-wrap__footer-text {
  width: 42rem;
  font-size: 0.875rem;
  color: var(--sand_600);
}
.webhook-wrap__footer-text p {
  margin: 0;
  margin-bottom: 6px;
}
.webhook-wrap__footer-text a {
  color: var(--grape_600);
  text-decoration: underline;
}
.webhook-wrap__footer-icon {
  margin: 0px 24px;
}
.webhook__title {
  font-weight: 500;
  margin-bottom: 24px;
}
.webhook__title-base {
  color: var(--sand_600);
  cursor: pointer;
}
.webhook__controls {
  display: flex;
  justify-content: space-between;
  margin-bottom: 32px;
}
.webhook-delete-modal__width-button {
  width: 170px;
}
.webhook-delete-modal__modal-text {
  margin-bottom: 32px;
}
.webhook-list__item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.5rem;
  font-size: 16px;
  border: 1px solid var(--sand_300);
  border-radius: 0.5rem;
}
.webhook-list__item:hover {
  background-color: var(--sand_100);
}
.webhook-list__item:hover .webhook-list__item-control {
  display: flex !important;
  justify-content: space-between;
}
.webhook-list__item + .webhook-list__item {
  margin-top: 1rem;
}
.webhook-list__url-wrap {
  display: flex;
  align-items: center;
}
.webhook-list__item-url {
  max-width: 370px;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  cursor: pointer;
  font-weight: 500;
  margin-left: 0.5rem;
}
.webhook-list__item-date {
  color: var(--sand_600);
  font-size: 0.875rem;
  margin-top: 0.25rem;
}
.webhook-list__item-control {
  display: none;
}
.webhook-list__item-control button + button {
  margin-left: 0.5rem;
}
.webhook-form__form-row {
  paddingLeft: 16;
}
.webhook-form__form-toggle {
  justify-content: flex-end;
}
.webhook-detail__width-button {
  width: 170px;
}
.webhook-detail__black-text {
  color: #000;
}
.webhook-detail__activator {
  width: 135px;
}
.webhook-detail__url-space {
  grid-template-columns: auto 135px;
}
.webhook-detail__url-input {
  align-self: stretch;
  width: auto;
}
.webhook-detail__form-label {
  padding-left: 0px;
}
.webhook-detail__form-row {
  margin-bottom: 24px;
}
.webhook-detail__delete-button {
  margin-right: auto;
}
.webhook-detail__cancel-button {
  margin-right: 1rem;
}
.webhook-detail__status {
  margin-right: 16px;
}
.webhook-detail__headers {
  border: 1px solid var(--sand_300);
  padding: 1rem;
  border-radius: 0.5rem;
  margin-bottom: 1rem;
}
.webhook-detail__headers-add {
  border: none;
  padding: 0px !important;
}
.webhook-detail__headers-add span {
  color: var(--grape_500) !important;
}
.webhook-detail__headers-row {
  grid-template-columns: 1fr 1fr 40px;
  margin: 0.5rem 0;
}
.webhook-detail__headers-remove {
  height: 32px;
  width: 32px;
  padding: 0px 0px !important;
  border: none;
}
.webhook-detail__controls {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-bottom: 32px;
}
.webhook-payload {
  border: 1px solid var(--sand_300);
  padding: 1rem;
  border-radius: 0.5rem;
  margin-bottom: 1rem;
}
.webhook-payload__content-row {
  margin: 0.5rem 0;
}
