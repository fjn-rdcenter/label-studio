@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-Regular.ttf") format("truetype");
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-SemiBold.ttf") format("truetype");
  font-weight: 500;
  font-style: normal;
  font-display: swap;
}
body {
  font-family: 'Figtree', sans-serif !important;
  --sand_900: #12110d;
  --sand_800: #262522;
  --sand_700: #45433e;
  --sand_600: #6b6860;
  --sand_500: #a49f95;
  --sand_400: #cac5b8;
  --sand_300: #e1ded5;
  --sand_200: #f0efeb;
  --sand_100: #f9f8f6;
  --sand_0: #fdfdfc;
  --grape_0: #f0f3fe;
  --grape_100: #d4dbfb;
  --grape_500: #566fcf;
  --grape_600: #576cc1;
  --grape_700: #4c5fa9;
  --grape_800: #37447a;
  --kale_0: #f4f9f9;
  --kale_400: #57b7ab;
  --plum_500: #cc6fbe;
  --plum_400: #e37bd3;
  --plum_100: #f7d6f2;
  --plum_0: #fbf2fc;
  --persimmon_300: #ff9f89;
  --persimmon_400: #ff7557;
  --canteloupe_0: #fff6ef;
  --canteloupe_100: #ffe4d0;
  --canteloupe_400: #ffa663;
  --canteloupe_500: #e69559;
  --canteloupe_600: #cc854f;
  --canteloupe_700: #b37445;
  --red_1: #fff1f0;
  --red_3: #ffccc7;
  --red_7: #cf1322;
  --red_10: #5c0011;
  --primary_link: #566fcf;
  --danger_color: var(--red_7);
}
.checkbox {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #000;
}
.checkbox__box {
  overflow: hidden;
  position: relative;
  white-space: nowrap;
  display: inline-block;
  max-width: 18px;
  max-height: 18px;
  cursor: pointer;
  margin: 2px;
}
.checkbox__input {
  top: 0;
  left: 0;
  margin: 0;
  padding: 0;
  opacity: 0;
  width: 100%;
  z-index: 10;
  height: 100%;
  border: none;
  position: absolute;
}
.checkbox__check {
  width: 18px;
  height: 18px;
  background: var(--sand_0);
  will-change: all;
  border-radius: 4px;
  position: relative;
  display: inline-block;
  transition: all 80ms ease;
  box-shadow: inset 0px -1px 0px rgba(0,0,0,0.1), inset 0px 0px 0px 1px rgba(0,0,0,0.15);
}
.checkbox__check::before,
.checkbox__check::after {
  top: 0;
  left: 0;
  bottom: 0;
  right: 0;
  display: block;
  content: '';
  opacity: 0;
  position: absolute;
}
.checkbox__check::before {
  background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg%20width=%2713%27%20height=%2710%27%20viewBox=%270%200%2013%2010%27%20fill=%27none%27%20xmlns=%27http://www.w3.org/2000/svg%27%3e%3cpath%20d=%27M1.5%204.5L5%208L11%202%27%20stroke=%27currentColor%27%20stroke-width=%272%27%20stroke-linecap=%27square%27/%3e%3c/svg%3e");
  background-repeat: no-repeat;
  background-position: center;
  transition: all 120ms ease;
}
.checkbox__check::after {
  top: 4px;
  left: 4px;
  bottom: 4px;
  right: 4px;
  border-radius: 2px;
  background-color: var(--grape_500);
}
.checkbox__check_checked::before {
  opacity: 1;
}
.checkbox__check_indeterminate::after {
  opacity: 1;
}
.checkbox__label {
  width: 100%;
  display: flex;
  align-items: center;
}
.checkbox:hover .checkbox__check {
  background-color: var(--grape_100);
}
.checkbox__input:checked + .checkbox__check::before {
  opacity: 1;
}
.checkbox_withLabel .checkbox__box {
  margin-right: 5px;
}
