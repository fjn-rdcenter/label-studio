@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-Regular.ttf") format("truetype");
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-SemiBold.ttf") format("truetype");
  font-weight: 500;
  font-style: normal;
  font-display: swap;
}
body {
  font-family: 'Figtree', sans-serif !important;
  --sand_900: #12110d;
  --sand_800: #262522;
  --sand_700: #45433e;
  --sand_600: #6b6860;
  --sand_500: #a49f95;
  --sand_400: #cac5b8;
  --sand_300: #e1ded5;
  --sand_200: #f0efeb;
  --sand_100: #f9f8f6;
  --sand_0: #fdfdfc;
  --grape_0: #f0f3fe;
  --grape_100: #d4dbfb;
  --grape_500: #566fcf;
  --grape_600: #576cc1;
  --grape_700: #4c5fa9;
  --grape_800: #37447a;
  --kale_0: #f4f9f9;
  --kale_400: #57b7ab;
  --plum_500: #cc6fbe;
  --plum_400: #e37bd3;
  --plum_100: #f7d6f2;
  --plum_0: #fbf2fc;
  --persimmon_300: #ff9f89;
  --persimmon_400: #ff7557;
  --canteloupe_0: #fff6ef;
  --canteloupe_100: #ffe4d0;
  --canteloupe_400: #ffa663;
  --canteloupe_500: #e69559;
  --canteloupe_600: #cc854f;
  --canteloupe_700: #b37445;
  --red_1: #fff1f0;
  --red_3: #ffccc7;
  --red_7: #cf1322;
  --red_10: #5c0011;
  --primary_link: #566fcf;
  --danger_color: var(--red_7);
}
.empty-state-default {
  max-width: 40rem;
  background: var(--grape_0);
  border: 1px solid var(--grape_500);
  padding: 2rem;
  border-radius: 0.5rem;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.empty-state-default__icon {
  margin-bottom: 0.75rem;
  background: var(--grape_100);
  padding: 0.5rem;
  display: flex;
  border-radius: 2rem;
}
.empty-state-default__icon svg path {
  fill: var(--grape_500);
}
.empty-state-default__action {
  margin-bottom: 1.25rem;
}
.empty-state-default__title {
  font-size: 1.75rem;
  font-weight: 500;
  color: var(--sand_900);
  margin-bottom: 1rem;
}
.empty-state-default__description {
  font-size: 1rem;
  color: var(--sand_900);
  margin-bottom: 1rem;
  text-align: center;
  line-height: 1.5em;
}
.empty-state-default__footer {
  font-size: 0.75rem;
  color: var(--sand_900);
  text-align: center;
  line-height: 1.5em;
}
.empty-state-default__footer a {
  color: var(--grape_700);
  text-decoration: underline;
}
.empty-state-default__footer a:hover {
  text-decoration: none;
}
