@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-Regular.ttf") format("truetype");
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-SemiBold.ttf") format("truetype");
  font-weight: 500;
  font-style: normal;
  font-display: swap;
}
body {
  font-family: 'Figtree', sans-serif !important;
  --sand_900: #12110d;
  --sand_800: #262522;
  --sand_700: #45433e;
  --sand_600: #6b6860;
  --sand_500: #a49f95;
  --sand_400: #cac5b8;
  --sand_300: #e1ded5;
  --sand_200: #f0efeb;
  --sand_100: #f9f8f6;
  --sand_0: #fdfdfc;
  --grape_0: #f0f3fe;
  --grape_100: #d4dbfb;
  --grape_500: #566fcf;
  --grape_600: #576cc1;
  --grape_700: #4c5fa9;
  --grape_800: #37447a;
  --kale_0: #f4f9f9;
  --kale_400: #57b7ab;
  --plum_500: #cc6fbe;
  --plum_400: #e37bd3;
  --plum_100: #f7d6f2;
  --plum_0: #fbf2fc;
  --persimmon_300: #ff9f89;
  --persimmon_400: #ff7557;
  --canteloupe_0: #fff6ef;
  --canteloupe_100: #ffe4d0;
  --canteloupe_400: #ffa663;
  --canteloupe_500: #e69559;
  --canteloupe_600: #cc854f;
  --canteloupe_700: #b37445;
  --red_1: #fff1f0;
  --red_3: #ffccc7;
  --red_7: #cf1322;
  --red_10: #5c0011;
  --primary_link: #566fcf;
  --danger_color: var(--red_7);
}
.prediction-card {
  width: 100%;
  padding: 15px;
  border-radius: 5px;
  background: var(--sand_100);
  border: 1px solid var(--sand_300);
  display: flex;
  justify-content: space-between;
}
.prediction-card__meta {
  display: flex;
  flex-flow: row wrap;
  gap: 20px;
  color: var(--sand_600);
  margin-top: 7px;
}
.prediction-card__group {
  display: flex;
  align-items: center;
}
.prediction-card__header {
  display: flex;
  height: 48px;
  padding: 0 15px;
  align-items: center;
  font-weight: 500;
  font-size: 16px;
  line-height: 18px;
  justify-content: space-between;
  box-shadow: 0 1px 0 0 var(--sand_300);
}
.prediction-card__title {
  font-weight: 500;
}
.prediction-card__title-content {
  display: flex;
  align-items: center;
}
.prediction-card__content {
  padding: 15px;
}
.prediction-card:not(:first-child) {
  margin-top: 24px;
}
