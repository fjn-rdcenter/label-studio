@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-Regular.ttf") format("truetype");
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-SemiBold.ttf") format("truetype");
  font-weight: 500;
  font-style: normal;
  font-display: swap;
}
body {
  font-family: 'Figtree', sans-serif !important;
  --sand_900: #12110d;
  --sand_800: #262522;
  --sand_700: #45433e;
  --sand_600: #6b6860;
  --sand_500: #a49f95;
  --sand_400: #cac5b8;
  --sand_300: #e1ded5;
  --sand_200: #f0efeb;
  --sand_100: #f9f8f6;
  --sand_0: #fdfdfc;
  --grape_0: #f0f3fe;
  --grape_100: #d4dbfb;
  --grape_500: #566fcf;
  --grape_600: #576cc1;
  --grape_700: #4c5fa9;
  --grape_800: #37447a;
  --kale_0: #f4f9f9;
  --kale_400: #57b7ab;
  --plum_500: #cc6fbe;
  --plum_400: #e37bd3;
  --plum_100: #f7d6f2;
  --plum_0: #fbf2fc;
  --persimmon_300: #ff9f89;
  --persimmon_400: #ff7557;
  --canteloupe_0: #fff6ef;
  --canteloupe_100: #ffe4d0;
  --canteloupe_400: #ffa663;
  --canteloupe_500: #e69559;
  --canteloupe_600: #cc854f;
  --canteloupe_700: #b37445;
  --red_1: #fff1f0;
  --red_3: #ffccc7;
  --red_7: #cf1322;
  --red_10: #5c0011;
  --primary_link: #566fcf;
  --danger_color: var(--red_7);
}
.menu-wrapper {
  max-width: 100%;
  min-height: 100vh;
  min-width: 100vw;
  font-size: 16px;
}
.menu-header {
  top: 0;
  height: var(--header-height);
  z-index: 1000;
  position: sticky;
  display: flex;
  box-sizing: border-box;
  background-color: var(--sand_0);
  justify-content: space-evenly;
  border-bottom: 1px solid var(--sand_300);
}
.menu-header__context {
  flex: 1;
  display: flex;
  padding: 0 0 0 1.125rem;
  align-items: center;
  justify-content: space-between;
}
.menu-header__context-item_left,
.menu-header__context-item_right {
  height: 100%;
  display: flex;
  align-items: center;
}
.menu-header__trigger {
  display: flex;
  padding: 0 20px;
  cursor: pointer;
  align-items: center;
  justify-content: space-between;
  min-width: 240px;
  max-width: 240px;
  box-sizing: border-box;
  box-shadow: 1px 0 0 0 rgba(0,0,0,0.1);
}
.menu-header__user {
  display: flex;
  margin: 0 20px;
  align-self: center;
  cursor: pointer;
  position: relative;
  align-items: center;
  justify-content: center;
}
.menu-header__userpic-badge {
  position: absolute;
  top: 0;
  right: 0;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--primary_link);
}
.newsletter-menu-item {
  width: 200px;
  white-space: normal;
  height: auto;
  padding-bottom: 8px;
  padding-top: 8px;
  margin-top: -8px;
  font-size: 14px;
  position: relative;
  background: rgba(0,153,255,0.133);
  line-height: 1.4em;
  transition: 0.2s all;
}
.main-menu .newsletter-menu-item:hover {
  background: rgba(0,153,255,0.2);
}
.newsletter-menu-badge {
  position: absolute;
  display: block;
  width: 8px;
  height: 8px;
  right: 8px;
  top: 8px;
  border-radius: 50%;
  background: #09f;
}
