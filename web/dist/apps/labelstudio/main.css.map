@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-Regular.ttf") format("truetype");
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-SemiBold.ttf") format("truetype");
  font-weight: 500;
  font-style: normal;
  font-display: swap;
}
body {
  font-family: 'Figtree', sans-serif !important;
  --sand_900: #12110d;
  --sand_800: #262522;
  --sand_700: #45433e;
  --sand_600: #6b6860;
  --sand_500: #a49f95;
  --sand_400: #cac5b8;
  --sand_300: #e1ded5;
  --sand_200: #f0efeb;
  --sand_100: #f9f8f6;
  --sand_0: #fdfdfc;
  --grape_0: #f0f3fe;
  --grape_100: #d4dbfb;
  --grape_500: #566fcf;
  --grape_600: #576cc1;
  --grape_700: #4c5fa9;
  --grape_800: #37447a;
  --kale_0: #f4f9f9;
  --kale_400: #57b7ab;
  --plum_500: #cc6fbe;
  --plum_400: #e37bd3;
  --plum_100: #f7d6f2;
  --plum_0: #fbf2fc;
  --persimmon_300: #ff9f89;
  --persimmon_400: #ff7557;
  --canteloupe_0: #fff6ef;
  --canteloupe_100: #ffe4d0;
  --canteloupe_400: #ffa663;
  --canteloupe_500: #e69559;
  --canteloupe_600: #cc854f;
  --canteloupe_700: #b37445;
  --red_1: #fff1f0;
  --red_3: #ffccc7;
  --red_7: #cf1322;
  --red_10: #5c0011;
  --primary_link: #566fcf;
  --danger_color: var(--red_7);
}
.prediction-settings__wrapper {
  width: 680px;
}
.prediction-settings__model-exists-info {
  align-items: center;
  margin-bottom: 20px;
  background: #fafafa;
  padding: 10px 20px;
  border: 1px solid rgba(137,128,152,0.16);
  border-radius: 8px;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 10px;
}
.prediction-settings__title-block {
  margin: 20px 0px;
  margin-top: 0px;
}
.prediction-settings__title {
  font-weight: 500;
}
.ml {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-column-gap: 16px;
  grid-row-gap: 16px;
  margin-top: 32px;
  align-items: flex-start;
  grid-auto-rows: max-content;
}
.ml__info {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.ml__status {
  color: rgba(0,0,0,0.4);
  display: flex;
  align-items: center;
  margin-right: 10px;
}
.ml__summary {
  margin-bottom: 16px;
}
.ml__indicator {
  width: 8px;
  height: 8px;
  display: block;
  margin-right: 8px;
  border-radius: 100%;
  background-color: var(--indicator-color);
}
.ml__indicator_state_CO {
  --indicator-color: #7fc84d;
}
.ml__indicator_state_DI {
  --indicator-color: #ffa940;
}
.ml__indicator_state_ER {
  --indicator-color: #ff4d4f;
}
.ml__indicator_state_TR,
.ml__indicator_state_PR {
  --indicator-color: #4095ff;
  position: relative;
}
.ml__indicator_state_TR::before,
.ml__indicator_state_PR::before {
  top: 0;
  left: 0;
  content: '';
  width: 100%;
  height: 100%;
  opacity: 0.5;
  display: block;
  border-radius: 100%;
  background-color: var(--indicator-color);
  animation: state-pulse 2s ease infinite;
}
@-moz-keyframes state-pulse {
  0% {
    transform: scale(1);
  }
  50% {
    opacity: 0;
    transform: scale(3);
  }
  100% {
    opacity: 0;
    transform: scale(3);
  }
}
@-webkit-keyframes state-pulse {
  0% {
    transform: scale(1);
  }
  50% {
    opacity: 0;
    transform: scale(3);
  }
  100% {
    opacity: 0;
    transform: scale(3);
  }
}
@-o-keyframes state-pulse {
  0% {
    transform: scale(1);
  }
  50% {
    opacity: 0;
    transform: scale(3);
  }
  100% {
    opacity: 0;
    transform: scale(3);
  }
}
@keyframes state-pulse {
  0% {
    transform: scale(1);
  }
  50% {
    opacity: 0;
    transform: scale(3);
  }
  100% {
    opacity: 0;
    transform: scale(3);
  }
}
