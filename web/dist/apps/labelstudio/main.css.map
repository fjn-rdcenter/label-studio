@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-Regular.ttf") format("truetype");
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-SemiBold.ttf") format("truetype");
  font-weight: 500;
  font-style: normal;
  font-display: swap;
}
body {
  font-family: 'Figtree', sans-serif !important;
  --sand_900: #12110d;
  --sand_800: #262522;
  --sand_700: #45433e;
  --sand_600: #6b6860;
  --sand_500: #a49f95;
  --sand_400: #cac5b8;
  --sand_300: #e1ded5;
  --sand_200: #f0efeb;
  --sand_100: #f9f8f6;
  --sand_0: #fdfdfc;
  --grape_0: #f0f3fe;
  --grape_100: #d4dbfb;
  --grape_500: #566fcf;
  --grape_600: #576cc1;
  --grape_700: #4c5fa9;
  --grape_800: #37447a;
  --kale_0: #f4f9f9;
  --kale_400: #57b7ab;
  --plum_500: #cc6fbe;
  --plum_400: #e37bd3;
  --plum_100: #f7d6f2;
  --plum_0: #fbf2fc;
  --persimmon_300: #ff9f89;
  --persimmon_400: #ff7557;
  --canteloupe_0: #fff6ef;
  --canteloupe_100: #ffe4d0;
  --canteloupe_400: #ffa663;
  --canteloupe_500: #e69559;
  --canteloupe_600: #cc854f;
  --canteloupe_700: #b37445;
  --red_1: #fff1f0;
  --red_3: #ffccc7;
  --red_7: #cf1322;
  --red_10: #5c0011;
  --primary_link: #566fcf;
  --danger_color: var(--red_7);
}
body {
  --header-height: 48px;
  --menu-animation-duration: 0.15s;
  --menu-animation-curve: cubic-bezier(0.21, 1.04, 0.68, 1);
  --menu-animation-start: -10px;
  --menu-sidebar-width: 240px;
  margin: 0;
  font-family: 'Figtree', sans-serif;
}
.app-wrapper {
  width: 100vw;
  max-width: 100%;
  min-height: 100vh;
}
.global-error {
  padding: 32px;
}
.global-error__heidi {
  display: block;
  margin: 32px auto;
}
.global-error h1 {
  text-transform: uppercase;
  text-align: center;
  font-size: 20px;
}
.global-error h2 {
  font-size: 20px;
  color: var(--red_7);
}
.global-error__details {
  background: #f5f5f5;
  max-height: 320px;
  overflow-y: auto;
  white-space: pre-wrap;
  margin: 16px 0;
  padding: 16px;
}
.global-error__actions {
  display: flex;
  gap: 8px;
}
.global-error__actions > * {
  line-height: 1em;
}
.global-error__slack {
  margin-right: auto;
  display: flex;
  align-items: center;
}
.global-error__slack img {
  height: 16px;
  width: 16px;
  margin-right: 8px;
}
.color {
  margin: 4px 8px;
  position: relative;
}
.color::before {
  width: 24px;
  height: 24px;
  display: block;
  margin: 0 auto;
  content: '';
  border-radius: 100%;
  background-color: var(--background);
  box-shadow: inset 0px 0px 0px 1px rgba(0,0,0,0.15);
}
