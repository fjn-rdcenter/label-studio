@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-Regular.ttf") format("truetype");
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-SemiBold.ttf") format("truetype");
  font-weight: 500;
  font-style: normal;
  font-display: swap;
}
body {
  font-family: 'Figtree', sans-serif !important;
  --sand_900: #12110d;
  --sand_800: #262522;
  --sand_700: #45433e;
  --sand_600: #6b6860;
  --sand_500: #a49f95;
  --sand_400: #cac5b8;
  --sand_300: #e1ded5;
  --sand_200: #f0efeb;
  --sand_100: #f9f8f6;
  --sand_0: #fdfdfc;
  --grape_0: #f0f3fe;
  --grape_100: #d4dbfb;
  --grape_500: #566fcf;
  --grape_600: #576cc1;
  --grape_700: #4c5fa9;
  --grape_800: #37447a;
  --kale_0: #f4f9f9;
  --kale_400: #57b7ab;
  --plum_500: #cc6fbe;
  --plum_400: #e37bd3;
  --plum_100: #f7d6f2;
  --plum_0: #fbf2fc;
  --persimmon_300: #ff9f89;
  --persimmon_400: #ff7557;
  --canteloupe_0: #fff6ef;
  --canteloupe_100: #ffe4d0;
  --canteloupe_400: #ffa663;
  --canteloupe_500: #e69559;
  --canteloupe_600: #cc854f;
  --canteloupe_700: #b37445;
  --red_1: #fff1f0;
  --red_3: #ffccc7;
  --red_7: #cf1322;
  --red_10: #5c0011;
  --primary_link: #566fcf;
  --danger_color: var(--red_7);
}
.projects-page {
  min-height: calc(100vh - var(--header-height));
}
.projects-page__loading {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: calc(100vh - var(--header-height));
}
.projects-page__list {
  padding: 40px;
  display: grid;
  grid-autoflow: columns;
  box-sizing: border-box;
  grid-gap: 32px;
  grid-auto-rows: 1fr;
  grid-template-columns: repeat(4, 1fr);
}
.projects-page__link {
  color: #000;
  display: block;
  display: flex;
  text-decoration: none;
}
.projects-page__link:hover {
  color: #000;
}
.projects-page__pages {
  background-color: var(--sand_0);
  bottom: 0;
  width: 100%;
  position: sticky;
  display: flex;
  padding: 10px 40px;
  justify-content: flex-end;
  box-sizing: border-box;
}
@media (min-width: 1200px) {
  .projects-page__list {
    grid-template-columns: repeat(3, 1fr);
  }
}
@media (min-width: 1360px) {
  .projects-page__list {
    grid-template-columns: repeat(4, 1fr);
  }
}
@media (min-width: 1460px) {
  .projects-page__list {
    grid-template-columns: repeat(5, 1fr);
  }
}
.empty-projects-page {
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.empty-projects-page__heidi {
  height: 12rem;
  margin-top: 6rem;
}
.empty-projects-page__header {
  font-size: 32px;
  font-weight: 700;
  margin: 16px;
  color: var(--sand_900);
}
.empty-projects-page p {
  font-size: 1.25rem;
  color: var(--sand_700);
  margin: 0;
}
.empty-projects-page__action {
  margin: 2rem 0;
}
.project-card {
  --text-color: var(--sand_900);
  flex: 1;
  display: flex;
  flex-direction: column;
  background: var(--sand_0);
  border: 1px solid var(--sand_300);
  border-radius: 0.5rem;
  overflow: hidden;
  color: var(--text-color);
  box-shadow: 0px 4px 8px rgba(0,0,0,0.05);
}
.project-card__header {
  padding: 12px 16px;
  border-bottom: 1px solid var(--sand_300);
}
.project-card__menu {
  margin-left: auto;
}
.project-card__menu .button {
  margin-right: -10px;
  opacity: 0.5;
  --button-color: var(--text-color);
}
.project-card__menu .button__icon {
  width: 18px;
  height: 18px;
}
.project-card__title {
  display: flex;
  font-size: 16px;
  font-weight: 500;
  margin-bottom: 0.25rem;
  line-height: 22px;
  align-items: center;
}
.project-card__title-text {
  max-width: 250px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.project-card__summary {
  flex: 1;
  font-size: 14px;
  line-height: 22px;
}
.project-card__annotation {
  display: flex;
  justify-content: space-between;
}
.project-card__detail {
  display: grid;
  grid-auto-flow: column;
  grid-gap: 16px;
  grid-auto-columns: max-content;
}
.project-card__detail-item {
  --icon-color: var(--sand_0);
  display: flex;
  align-items: center;
}
.project-card__icon {
  color: var(--icon-color);
}
.project-card__detail-item_type_completed {
  --icon-color: var(--kale_400);
}
.project-card__detail-item_type_rejected {
  --icon-color: var(--red_7);
}
.project-card__detail-item_type_predictions {
  --icon-color: var(--grape_500);
}
.project-card__icon {
  margin-right: 10px;
}
.project-card__description {
  flex: 1;
  font-size: 16px;
  line-height: 22px;
  padding: 12px 16px 0;
  overflow: hidden;
  color: var(--sand_700);
  text-overflow: ellipsis;
  display: -webkit-box;
  word-break: break-word;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}
.project-card__info {
  display: flex;
  align-items: center;
  padding: 16px 16px 10px 16px;
  justify-content: space-between;
}
.project-card__created-date {
  color: var(--sand_600);
  font-size: 0.875rem;
}
.project-card__created-date > span {
  font-weight: 500;
}
.project-card_colored {
  --text-color: var(--sand_0);
  background-color: var(--background-color);
}
.project-card_colored .project-card__header {
  background-color: var(--header-color);
  box-shadow: none;
}
.project-card_colored .project-card__detail-item {
  --icon-color: var(--sand_0);
}
