@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-Regular.ttf") format("truetype");
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-SemiBold.ttf") format("truetype");
  font-weight: 500;
  font-style: normal;
  font-display: swap;
}
body {
  font-family: 'Figtree', sans-serif !important;
  --sand_900: #12110d;
  --sand_800: #262522;
  --sand_700: #45433e;
  --sand_600: #6b6860;
  --sand_500: #a49f95;
  --sand_400: #cac5b8;
  --sand_300: #e1ded5;
  --sand_200: #f0efeb;
  --sand_100: #f9f8f6;
  --sand_0: #fdfdfc;
  --grape_0: #f0f3fe;
  --grape_100: #d4dbfb;
  --grape_500: #566fcf;
  --grape_600: #576cc1;
  --grape_700: #4c5fa9;
  --grape_800: #37447a;
  --kale_0: #f4f9f9;
  --kale_400: #57b7ab;
  --plum_500: #cc6fbe;
  --plum_400: #e37bd3;
  --plum_100: #f7d6f2;
  --plum_0: #fbf2fc;
  --persimmon_300: #ff9f89;
  --persimmon_400: #ff7557;
  --canteloupe_0: #fff6ef;
  --canteloupe_100: #ffe4d0;
  --canteloupe_400: #ffa663;
  --canteloupe_500: #e69559;
  --canteloupe_600: #cc854f;
  --canteloupe_700: #b37445;
  --red_1: #fff1f0;
  --red_3: #ffccc7;
  --red_7: #cf1322;
  --red_10: #5c0011;
  --primary_link: #566fcf;
  --danger_color: var(--red_7);
}
.hamburger {
  width: 18px;
  height: 14px;
  cursor: pointer;
  position: relative;
  display: inline-block;
}
.hamburger span {
  height: 2px;
  width: 100%;
  display: block;
  position: absolute;
  background-color: #000;
}
.hamburger span:nth-child(1) {
  top: 0;
}
.hamburger span:nth-child(2) {
  top: 50%;
  transform: translate3d(0, -50%, 0);
}
.hamburger span:nth-child(3) {
  bottom: 0;
}
.hamburger_animated span {
  transition: all var(--menu-animation-duration) ease;
}
.hamburger:hover span,
.hamburger_opened span {
  background-color: var(--sand_900);
}
.hamburger_opened span:nth-child(1) {
  top: 6px;
  transform: rotate(135deg);
}
.hamburger_opened span:nth-child(2) {
  opacity: 0;
  transform: translate3d(-100%, -50%, 0);
}
.hamburger_opened span:nth-child(3) {
  bottom: 6px;
  transform: rotate(-135deg);
}
