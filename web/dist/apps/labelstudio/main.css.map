@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-Regular.ttf") format("truetype");
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-SemiBold.ttf") format("truetype");
  font-weight: 500;
  font-style: normal;
  font-display: swap;
}
body {
  font-family: 'Figtree', sans-serif !important;
  --sand_900: #12110d;
  --sand_800: #262522;
  --sand_700: #45433e;
  --sand_600: #6b6860;
  --sand_500: #a49f95;
  --sand_400: #cac5b8;
  --sand_300: #e1ded5;
  --sand_200: #f0efeb;
  --sand_100: #f9f8f6;
  --sand_0: #fdfdfc;
  --grape_0: #f0f3fe;
  --grape_100: #d4dbfb;
  --grape_500: #566fcf;
  --grape_600: #576cc1;
  --grape_700: #4c5fa9;
  --grape_800: #37447a;
  --kale_0: #f4f9f9;
  --kale_400: #57b7ab;
  --plum_500: #cc6fbe;
  --plum_400: #e37bd3;
  --plum_100: #f7d6f2;
  --plum_0: #fbf2fc;
  --persimmon_300: #ff9f89;
  --persimmon_400: #ff7557;
  --canteloupe_0: #fff6ef;
  --canteloupe_100: #ffe4d0;
  --canteloupe_400: #ffa663;
  --canteloupe_500: #e69559;
  --canteloupe_600: #cc854f;
  --canteloupe_700: #b37445;
  --red_1: #fff1f0;
  --red_3: #ffccc7;
  --red_7: #cf1322;
  --red_10: #5c0011;
  --primary_link: #566fcf;
  --danger_color: var(--red_7);
}
.user-info {
  padding: 20px 24px;
  border: 1px solid var(--sand_300);
  background: var(--sand_0);
  align-self: start;
  display: flex;
  flex-direction: column;
  position: relative;
  border-radius: 4px;
}
.user-info__close {
  top: 20px;
  right: 24px;
  width: 32px;
  height: 32px;
  position: absolute;
  --button-color: var(--grape_500);
  border: none;
}
.user-info__header {
  display: grid;
  grid-template: auto/64px auto;
  column-gap: 16px;
  line-height: 1.5;
  color: var(--sand_600);
  margin-bottom: 16px;
  align-items: center;
}
.user-info__email {
  margin: 0;
}
.user-info__full-name {
  font-size: 1.5em;
  margin: 0;
  font-weight: 500;
  line-height: 1.2;
  color: var(--sand_900);
}
.user-info__section + .user-info__section {
  margin-top: 16px;
}
.user-info__section-title {
  margin-top: 1em;
  margin-bottom: 8px;
  font-weight: 500;
}
.user-info__last-active {
  color: var(--sand_600);
  margin-top: 32px;
  margin-bottom: 0;
}
.user-info__links-list {
  display: flex;
  flex-direction: column;
  max-width: 350px;
}
.user-info__project-link {
  height: 36px;
  display: flex;
  padding: 0 10px;
  font-size: 16px;
  margin-left: -10px;
  align-items: center;
  border-radius: 4px;
  color: #566fcf;
}
.user-info__project-link:hover {
  background-color: var(--grape_0);
}
