@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-Regular.ttf") format("truetype");
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-SemiBold.ttf") format("truetype");
  font-weight: 500;
  font-style: normal;
  font-display: swap;
}
body {
  font-family: 'Figtree', sans-serif !important;
  --sand_900: #12110d;
  --sand_800: #262522;
  --sand_700: #45433e;
  --sand_600: #6b6860;
  --sand_500: #a49f95;
  --sand_400: #cac5b8;
  --sand_300: #e1ded5;
  --sand_200: #f0efeb;
  --sand_100: #f9f8f6;
  --sand_0: #fdfdfc;
  --grape_0: #f0f3fe;
  --grape_100: #d4dbfb;
  --grape_500: #566fcf;
  --grape_600: #576cc1;
  --grape_700: #4c5fa9;
  --grape_800: #37447a;
  --kale_0: #f4f9f9;
  --kale_400: #57b7ab;
  --plum_500: #cc6fbe;
  --plum_400: #e37bd3;
  --plum_100: #f7d6f2;
  --plum_0: #fbf2fc;
  --persimmon_300: #ff9f89;
  --persimmon_400: #ff7557;
  --canteloupe_0: #fff6ef;
  --canteloupe_100: #ffe4d0;
  --canteloupe_400: #ffa663;
  --canteloupe_500: #e69559;
  --canteloupe_600: #cc854f;
  --canteloupe_700: #b37445;
  --red_1: #fff1f0;
  --red_3: #ffccc7;
  --red_7: #cf1322;
  --red_10: #5c0011;
  --primary_link: #566fcf;
  --danger_color: var(--red_7);
}
.heidy-tip__content {
  padding: 1rem;
  border: 1px solid var(--sand_300);
  font-size: 14px;
  border-radius: 8px;
  box-shadow: 0px 2px 6px 0px rgba(0,0,0,0.1);
  box-sizing: border-box;
  background: var(--sand_0);
}
.heidy-tip__header {
  display: flex;
  width: 100%;
  min-height: 24px;
  margin-bottom: 8px;
  flex-direction: row;
  justify-content: space-between;
}
.heidy-tip__title {
  font-size: 16px;
  font-weight: 500;
  line-height: 24px;
  letter-spacing: 0.15px;
}
.heidy-tip__text {
  line-height: 20px;
  letter-spacing: 0.25px;
}
.heidy-tip__link {
  color: var(--grape_500);
  font-weight: 500;
}
.heidy-tip__link:hover {
  text-decoration: underline;
}
.heidy-tip__link::before {
  content: " ";
}
.heidy-tip__dismiss {
  width: 24px;
  height: 24px;
  padding: 0;
  border: none;
  display: flex;
  box-shadow: none;
  justify-content: center;
  align-items: center;
}
.heidy-tip__dismiss svg {
  width: 14px;
  height: 14px;
}
.heidy-tip__dismiss svg > path {
  stroke: #898098;
}
.heidy-tip__dismiss:hover {
  background: var(--grape_0);
}
.heidy-tip__dismiss:hover svg > path {
  stroke: #1f1f1f;
}
.heidy-tip__heidi {
  margin-top: -12px;
  padding-left: 16px;
  pointer-events: none;
}
