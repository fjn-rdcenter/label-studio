@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-Regular.ttf") format("truetype");
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-SemiBold.ttf") format("truetype");
  font-weight: 500;
  font-style: normal;
  font-display: swap;
}
body {
  font-family: 'Figtree', sans-serif !important;
  --sand_900: #12110d;
  --sand_800: #262522;
  --sand_700: #45433e;
  --sand_600: #6b6860;
  --sand_500: #a49f95;
  --sand_400: #cac5b8;
  --sand_300: #e1ded5;
  --sand_200: #f0efeb;
  --sand_100: #f9f8f6;
  --sand_0: #fdfdfc;
  --grape_0: #f0f3fe;
  --grape_100: #d4dbfb;
  --grape_500: #566fcf;
  --grape_600: #576cc1;
  --grape_700: #4c5fa9;
  --grape_800: #37447a;
  --kale_0: #f4f9f9;
  --kale_400: #57b7ab;
  --plum_500: #cc6fbe;
  --plum_400: #e37bd3;
  --plum_100: #f7d6f2;
  --plum_0: #fbf2fc;
  --persimmon_300: #ff9f89;
  --persimmon_400: #ff7557;
  --canteloupe_0: #fff6ef;
  --canteloupe_100: #ffe4d0;
  --canteloupe_400: #ffa663;
  --canteloupe_500: #e69559;
  --canteloupe_600: #cc854f;
  --canteloupe_700: #b37445;
  --red_1: #fff1f0;
  --red_3: #ffccc7;
  --red_7: #cf1322;
  --red_10: #5c0011;
  --primary_link: #566fcf;
  --danger_color: var(--red_7);
}
.spinner {
  --spinner-size: 50px;
  --corner-size: calc(var(--spinner-size) * 0.375);
  --spinner-duration: 2.5s;
  --spinner-color: #fa8c16;
  position: relative;
  width: var(--spinner-size);
  height: var(--spinner-size);
}
.spinner__body {
  top: 50%;
  left: 50%;
  width: var(--spinner-size);
  height: var(--spinner-size);
  position: absolute;
  transform: translate(-50%, -50%);
  background-color: rgba(250,140,22,0.2);
  box-shadow: 0 0 0 calc(var(--spinner-size) * 0.0625) #ffa940 inset, 0 0 0 calc(var(--spinner-size) * 0.0625) #ffa940;
  will-change: transform, width, height;
}
.spinner__body:not(.spinner__body_stopped) {
  animation: logo-spin var(--spinner-duration) ease infinite;
}
.spinner__body > span {
  position: absolute;
  background-color: #fa8c16;
  width: var(--corner-size);
  height: var(--corner-size);
  border-radius: calc(var(--corner-size) * 0.16);
}
.spinner__body > span:nth-child(1) {
  top: 0;
  left: 0;
  transform: translate(-50%, -50%);
}
.spinner__body > span:nth-child(2) {
  top: 0;
  right: 0;
  transform: translate(50%, -50%);
}
.spinner__body > span:nth-child(3) {
  bottom: 0;
  left: 0;
  transform: translate(-50%, 50%);
}
.spinner__body > span:nth-child(4) {
  bottom: 0;
  right: 0;
  transform: translate(50%, 50%);
}
@-moz-keyframes logo-spin {
  0% {
    transform: translate(-50%, -50%) rotate(0deg);
  }
  20% {
    width: 0;
    height: 0;
    transform: translate(-50%, -50%) rotate(0deg);
  }
  45% {
    width: 0;
    height: 0;
    transform: translate(-50%, -50%) rotate(90deg);
  }
  70% {
    width: var(--spinner-size);
    height: var(--spinner-size);
    transform: translate(-50%, -50%) rotate(90deg);
  }
  100% {
    width: var(--spinner-size);
    height: var(--spinner-size);
    transform: translate(-50%, -50%) rotate(90deg);
  }
}
@-webkit-keyframes logo-spin {
  0% {
    transform: translate(-50%, -50%) rotate(0deg);
  }
  20% {
    width: 0;
    height: 0;
    transform: translate(-50%, -50%) rotate(0deg);
  }
  45% {
    width: 0;
    height: 0;
    transform: translate(-50%, -50%) rotate(90deg);
  }
  70% {
    width: var(--spinner-size);
    height: var(--spinner-size);
    transform: translate(-50%, -50%) rotate(90deg);
  }
  100% {
    width: var(--spinner-size);
    height: var(--spinner-size);
    transform: translate(-50%, -50%) rotate(90deg);
  }
}
@-o-keyframes logo-spin {
  0% {
    transform: translate(-50%, -50%) rotate(0deg);
  }
  20% {
    width: 0;
    height: 0;
    transform: translate(-50%, -50%) rotate(0deg);
  }
  45% {
    width: 0;
    height: 0;
    transform: translate(-50%, -50%) rotate(90deg);
  }
  70% {
    width: var(--spinner-size);
    height: var(--spinner-size);
    transform: translate(-50%, -50%) rotate(90deg);
  }
  100% {
    width: var(--spinner-size);
    height: var(--spinner-size);
    transform: translate(-50%, -50%) rotate(90deg);
  }
}
@keyframes logo-spin {
  0% {
    transform: translate(-50%, -50%) rotate(0deg);
  }
  20% {
    width: 0;
    height: 0;
    transform: translate(-50%, -50%) rotate(0deg);
  }
  45% {
    width: 0;
    height: 0;
    transform: translate(-50%, -50%) rotate(90deg);
  }
  70% {
    width: var(--spinner-size);
    height: var(--spinner-size);
    transform: translate(-50%, -50%) rotate(90deg);
  }
  100% {
    width: var(--spinner-size);
    height: var(--spinner-size);
    transform: translate(-50%, -50%) rotate(90deg);
  }
}
