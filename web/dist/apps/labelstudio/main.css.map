@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-Regular.ttf") format("truetype");
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-SemiBold.ttf") format("truetype");
  font-weight: 500;
  font-style: normal;
  font-display: swap;
}
body {
  font-family: 'Figtree', sans-serif !important;
  --sand_900: #12110d;
  --sand_800: #262522;
  --sand_700: #45433e;
  --sand_600: #6b6860;
  --sand_500: #a49f95;
  --sand_400: #cac5b8;
  --sand_300: #e1ded5;
  --sand_200: #f0efeb;
  --sand_100: #f9f8f6;
  --sand_0: #fdfdfc;
  --grape_0: #f0f3fe;
  --grape_100: #d4dbfb;
  --grape_500: #566fcf;
  --grape_600: #576cc1;
  --grape_700: #4c5fa9;
  --grape_800: #37447a;
  --kale_0: #f4f9f9;
  --kale_400: #57b7ab;
  --plum_500: #cc6fbe;
  --plum_400: #e37bd3;
  --plum_100: #f7d6f2;
  --plum_0: #fbf2fc;
  --persimmon_300: #ff9f89;
  --persimmon_400: #ff7557;
  --canteloupe_0: #fff6ef;
  --canteloupe_100: #ffe4d0;
  --canteloupe_400: #ffa663;
  --canteloupe_500: #e69559;
  --canteloupe_600: #cc854f;
  --canteloupe_700: #b37445;
  --red_1: #fff1f0;
  --red_3: #ffccc7;
  --red_7: #cf1322;
  --red_10: #5c0011;
  --primary_link: #566fcf;
  --danger_color: var(--red_7);
}
.create-project {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow-y: auto;
}
.create-project > .modal__header {
  border-bottom: 1px solid var(--sand_300);
}
.create-project > .modal__header h1 {
  width: 224px;
  margin-right: auto;
  margin-bottom: 0;
  margin-top: 0;
  font-size: 20px;
}
.create-project > .modal__header button {
  line-height: 1em;
  min-width: 100px;
}
.create-project > .modal__header .toggle-items {
  width: 500px;
  margin-right: auto;
  box-sizing: border-box;
}
.create-project__tab_disabled {
  display: flex;
  align-items: center;
  justify-content: center;
}
.create-project__tab_disabled::before {
  content: "";
  display: block;
  height: 8px;
  width: 8px;
  border-radius: 4px;
  margin-right: 6px;
  background: #cf1322;
}
.create-project form.project-name {
  width: 500px;
  margin: 32px auto;
}
.create-project form.project-name > *:not(:first-child) {
  margin-top: 32px;
}
.create-project form.project-name label {
  display: inline-flex;
  align-items: center;
}
.create-project .project-name .caption {
  margin-bottom: 32px;
}
