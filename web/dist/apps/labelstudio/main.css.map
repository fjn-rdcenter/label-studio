@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-Regular.ttf") format("truetype");
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-SemiBold.ttf") format("truetype");
  font-weight: 500;
  font-style: normal;
  font-display: swap;
}
body {
  font-family: 'Figtree', sans-serif !important;
  --sand_900: #12110d;
  --sand_800: #262522;
  --sand_700: #45433e;
  --sand_600: #6b6860;
  --sand_500: #a49f95;
  --sand_400: #cac5b8;
  --sand_300: #e1ded5;
  --sand_200: #f0efeb;
  --sand_100: #f9f8f6;
  --sand_0: #fdfdfc;
  --grape_0: #f0f3fe;
  --grape_100: #d4dbfb;
  --grape_500: #566fcf;
  --grape_600: #576cc1;
  --grape_700: #4c5fa9;
  --grape_800: #37447a;
  --kale_0: #f4f9f9;
  --kale_400: #57b7ab;
  --plum_500: #cc6fbe;
  --plum_400: #e37bd3;
  --plum_100: #f7d6f2;
  --plum_0: #fbf2fc;
  --persimmon_300: #ff9f89;
  --persimmon_400: #ff7557;
  --canteloupe_0: #fff6ef;
  --canteloupe_100: #ffe4d0;
  --canteloupe_400: #ffa663;
  --canteloupe_500: #e69559;
  --canteloupe_600: #cc854f;
  --canteloupe_700: #b37445;
  --red_1: #fff1f0;
  --red_3: #ffccc7;
  --red_7: #cf1322;
  --red_10: #5c0011;
  --primary_link: #566fcf;
  --danger_color: var(--red_7);
}
.version-notifier {
  display: flex;
  padding: 10px 0;
  color: var(--grape_500);
  margin: 8px 0;
  background: rgba(0,119,255,0.08);
  border-radius: 5px;
}
.version-notifier a {
  display: flex;
}
.version-notifier a:visited {
  color: var(--grape_500);
}
.version-notifier__icon {
  width: 46px;
  padding-top: 1px;
}
.version-notifier__icon img {
  width: 20px;
  height: 20px;
  margin: 0 auto;
  display: block;
}
.version-notifier__content {
  flex: 1;
  padding-right: 12px;
}
.version-notifier__title {
  font-weight: 500;
  line-height: 22px;
  font-size: 16px;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}
.version-notifier__title::after {
  opacity: 0.5;
  line-height: 22px;
  font-size: 14px;
  content: attr(data-date);
}
.version-notifier__description {
  padding-top: 8px;
  opacity: 0.6;
  font-size: 14px;
  line-height: 18px;
}
.current-version {
  display: flex;
  cursor: pointer;
  padding: 0 13px;
  margin-top: 5px;
  margin-left: 5px;
  border-radius: 3px;
  box-sizing: border-box;
  color: #999;
  font-size: 12px;
  white-space: nowrap;
  text-decoration: none;
}
.current-version:hover {
  color: #222;
}
