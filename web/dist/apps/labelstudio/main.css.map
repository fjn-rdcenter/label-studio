@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-Regular.ttf") format("truetype");
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-SemiBold.ttf") format("truetype");
  font-weight: 500;
  font-style: normal;
  font-display: swap;
}
body {
  font-family: 'Figtree', sans-serif !important;
  --sand_900: #12110d;
  --sand_800: #262522;
  --sand_700: #45433e;
  --sand_600: #6b6860;
  --sand_500: #a49f95;
  --sand_400: #cac5b8;
  --sand_300: #e1ded5;
  --sand_200: #f0efeb;
  --sand_100: #f9f8f6;
  --sand_0: #fdfdfc;
  --grape_0: #f0f3fe;
  --grape_100: #d4dbfb;
  --grape_500: #566fcf;
  --grape_600: #576cc1;
  --grape_700: #4c5fa9;
  --grape_800: #37447a;
  --kale_0: #f4f9f9;
  --kale_400: #57b7ab;
  --plum_500: #cc6fbe;
  --plum_400: #e37bd3;
  --plum_100: #f7d6f2;
  --plum_0: #fbf2fc;
  --persimmon_300: #ff9f89;
  --persimmon_400: #ff7557;
  --canteloupe_0: #fff6ef;
  --canteloupe_100: #ffe4d0;
  --canteloupe_400: #ffa663;
  --canteloupe_500: #e69559;
  --canteloupe_600: #cc854f;
  --canteloupe_700: #b37445;
  --red_1: #fff1f0;
  --red_3: #ffccc7;
  --red_7: #cf1322;
  --red_10: #5c0011;
  --primary_link: #566fcf;
  --danger_color: var(--red_7);
}
.toast-viewport {
  --toast-spacing: 8px;
  position: fixed;
  display: flex;
  justify-content: center;
  width: 100%;
  z-index: 9999;
  bottom: 24px;
  pointer-events: none;
}
.toast-viewport ol {
  list-style: none;
}
.toast-viewport ol li + li {
  margin-top: var(--toast-spacing);
}
.toast-viewport ol:empty {
  display: none;
}
@media (prefers-reduced-motion: no-preference) {
  .toast-viewport li {
    will-change: opacity, transform;
  }
  .toast-viewport li[data-state="open"] {
    animation: toast-enter-up 100ms ease-out forwards;
  }
  .toast-viewport li[data-state="closed"] {
    animation: toast-leave-fade 100ms ease-out forwards;
  }
  .toast-viewport li[data-swipe="move"] {
    transform: translateY(var(--radix-toast-swipe-move-y));
  }
  .toast-viewport li[data-swipe="cancel"] {
    transform: translateY(0);
  }
  .toast-viewport li[data-swipe="end"] {
    animation: toast-leave-down 100ms ease-out forwards;
  }
}
.toast {
  --background-color: #fafafa;
  --border-color: rgba(137,128,152,0.16);
  --padding: 8px 16px;
  display: flex;
  align-items: center;
  gap: 16px;
  border-radius: 4px;
  overflow: hidden;
  border: 1px solid var(--border-color);
  background-color: var(--background-color);
}
.toast > div,
.toast__content {
  font-size: 16px;
  letter-spacing: 0.5px;
  line-height: 24px;
  flex: 1;
}
.toast__action,
.toast__content {
  padding: var(--padding);
}
.toast__action {
  font-weight: 500;
  font-size: 16px;
  letter-spacing: 0.15px;
  line-height: 24px;
  border: none;
  border-radius: 0;
  border-left: 1px solid var(--border-color);
}
@-moz-keyframes toast-enter-up {
  from {
    opacity: 0;
    transform: translateY(100%);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
@-webkit-keyframes toast-enter-up {
  from {
    opacity: 0;
    transform: translateY(100%);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
@-o-keyframes toast-enter-up {
  from {
    opacity: 0;
    transform: translateY(100%);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
@keyframes toast-enter-up {
  from {
    opacity: 0;
    transform: translateY(100%);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
@-moz-keyframes toast-leave-fade {
  from {
    opacity: 1;
  }
  to {
    opacity: 0;
  }
}
@-webkit-keyframes toast-leave-fade {
  from {
    opacity: 1;
  }
  to {
    opacity: 0;
  }
}
@-o-keyframes toast-leave-fade {
  from {
    opacity: 1;
  }
  to {
    opacity: 0;
  }
}
@keyframes toast-leave-fade {
  from {
    opacity: 1;
  }
  to {
    opacity: 0;
  }
}
@-moz-keyframes toast-leave-down {
  from {
    opacity: 1;
    transform: translateY(var(--radix-toast-swipe-end-y));
  }
  to {
    opacity: 0;
    transform: translateY(100%);
  }
}
@-webkit-keyframes toast-leave-down {
  from {
    opacity: 1;
    transform: translateY(var(--radix-toast-swipe-end-y));
  }
  to {
    opacity: 0;
    transform: translateY(100%);
  }
}
@-o-keyframes toast-leave-down {
  from {
    opacity: 1;
    transform: translateY(var(--radix-toast-swipe-end-y));
  }
  to {
    opacity: 0;
    transform: translateY(100%);
  }
}
@keyframes toast-leave-down {
  from {
    opacity: 1;
    transform: translateY(var(--radix-toast-swipe-end-y));
  }
  to {
    opacity: 0;
    transform: translateY(100%);
  }
}
