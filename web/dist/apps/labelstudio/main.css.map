@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-Regular.ttf") format("truetype");
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-SemiBold.ttf") format("truetype");
  font-weight: 500;
  font-style: normal;
  font-display: swap;
}
body {
  font-family: 'Figtree', sans-serif !important;
  --sand_900: #12110d;
  --sand_800: #262522;
  --sand_700: #45433e;
  --sand_600: #6b6860;
  --sand_500: #a49f95;
  --sand_400: #cac5b8;
  --sand_300: #e1ded5;
  --sand_200: #f0efeb;
  --sand_100: #f9f8f6;
  --sand_0: #fdfdfc;
  --grape_0: #f0f3fe;
  --grape_100: #d4dbfb;
  --grape_500: #566fcf;
  --grape_600: #576cc1;
  --grape_700: #4c5fa9;
  --grape_800: #37447a;
  --kale_0: #f4f9f9;
  --kale_400: #57b7ab;
  --plum_500: #cc6fbe;
  --plum_400: #e37bd3;
  --plum_100: #f7d6f2;
  --plum_0: #fbf2fc;
  --persimmon_300: #ff9f89;
  --persimmon_400: #ff7557;
  --canteloupe_0: #fff6ef;
  --canteloupe_100: #ffe4d0;
  --canteloupe_400: #ffa663;
  --canteloupe_500: #e69559;
  --canteloupe_600: #cc854f;
  --canteloupe_700: #b37445;
  --red_1: #fff1f0;
  --red_3: #ffccc7;
  --red_7: #cf1322;
  --red_10: #5c0011;
  --primary_link: #566fcf;
  --danger_color: var(--red_7);
}
.breadcrumbs {
  height: 100%;
  display: flex;
  align-items: center;
  margin-right: 20px;
}
.breadcrumbs__label {
  display: flex;
  gap: 4px;
  align-items: center;
}
.breadcrumbs__beta {
  font-size: 12px;
  font-style: normal;
  font-weight: 500;
  line-height: 16px;
  color: var(--plum_0);
  padding: 2px 8px;
  background-color: var(--plum_500);
  border-radius: 12px;
}
.breadcrumbs__list {
  height: 100%;
  display: flex;
  align-items: center;
  list-style-type: none;
  margin: 0;
  padding: 0;
}
.breadcrumbs__item {
  font-size: 16px;
  line-height: 22px;
  position: relative;
  margin: 0;
  padding: 0;
  height: 100%;
  display: flex;
  align-items: center;
  cursor: default;
}
.breadcrumbs__item:not(.breadcrumbs__item_last) {
  cursor: pointer;
}
.breadcrumbs__item:not(.breadcrumbs__item_last) > span,
.breadcrumbs__item:not(.breadcrumbs__item_last) > a {
  color: var(--sand_600) !important;
}
.breadcrumbs__item:not(:nth-child(2)) {
  flex-shrink: 0;
}
.breadcrumbs__item:nth-child(2) span {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.breadcrumbs__item:only-child {
  pointer-events: none;
}
.breadcrumbs__item > span,
.breadcrumbs__item > a {
  text-decoration: none;
  color: var(--sand_900);
}
.breadcrumbs__item > span:hover,
.breadcrumbs__item > a:hover {
  color: var(--grape_500) !important;
}
.breadcrumbs__item + .breadcrumbs__item {
  margin-left: 30px;
}
.breadcrumbs__item + .breadcrumbs__item::before {
  top: 50%;
  right: 100%;
  width: 30px;
  content: "/";
  height: 16px;
  display: block;
  color: var(--sand_600);
  position: absolute;
  transform: translate3d(0, -50%, 0);
  text-align: center;
  line-height: 16px;
  font-size: 18px;
}
.breadcrumbs__settings {
  width: 20px;
  height: 20px;
  display: block;
  margin-left: 10px;
}
.breadcrumbs__settings img {
  display: block;
  opacity: 0.23;
}
