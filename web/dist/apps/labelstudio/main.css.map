@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-Regular.ttf") format("truetype");
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-SemiBold.ttf") format("truetype");
  font-weight: 500;
  font-style: normal;
  font-display: swap;
}
body {
  font-family: 'Figtree', sans-serif !important;
  --sand_900: #12110d;
  --sand_800: #262522;
  --sand_700: #45433e;
  --sand_600: #6b6860;
  --sand_500: #a49f95;
  --sand_400: #cac5b8;
  --sand_300: #e1ded5;
  --sand_200: #f0efeb;
  --sand_100: #f9f8f6;
  --sand_0: #fdfdfc;
  --grape_0: #f0f3fe;
  --grape_100: #d4dbfb;
  --grape_500: #566fcf;
  --grape_600: #576cc1;
  --grape_700: #4c5fa9;
  --grape_800: #37447a;
  --kale_0: #f4f9f9;
  --kale_400: #57b7ab;
  --plum_500: #cc6fbe;
  --plum_400: #e37bd3;
  --plum_100: #f7d6f2;
  --plum_0: #fbf2fc;
  --persimmon_300: #ff9f89;
  --persimmon_400: #ff7557;
  --canteloupe_0: #fff6ef;
  --canteloupe_100: #ffe4d0;
  --canteloupe_400: #ffa663;
  --canteloupe_500: #e69559;
  --canteloupe_600: #cc854f;
  --canteloupe_700: #b37445;
  --red_1: #fff1f0;
  --red_3: #ffccc7;
  --red_7: #cf1322;
  --red_10: #5c0011;
  --primary_link: #566fcf;
  --danger_color: var(--red_7);
}
.pagination {
  height: 40px;
  display: inline-flex;
  align-items: center;
  --button-color: #566fcf;
}
.pagination_disabled {
  --button-color: #ccc;
  background-color: #efefef;
  pointer-events: none;
}
.pagination__label {
  padding-right: 16px;
  font-size: 16px;
  line-height: 19px;
  color: rgba(0,0,0,0.4);
}
.pagination__navigation {
  display: flex;
  height: 100%;
  align-items: center;
  border-radius: 5px;
  background: var(--sand_0);
  box-shadow: inset 0px -1px 0px rgba(0,0,0,0.1), inset 0px 0px 0px 1px rgba(0,0,0,0.15);
}
.pagination_waiting .pagination__navigation {
  pointer-events: none;
  animation: button-waiting 1s linear infinite;
  background-image: repeating-linear-gradient(-63.43deg, rgba(255,255,255,0.2) 1px, #efefef 2px, #efefef 6px, rgba(255,255,255,0.2) 7px, rgba(255,255,255,0.2) 12px);
}
.pagination__divider {
  width: 1px;
  height: 30px;
  background-color: rgba(0,0,0,0.1);
}
.pagination__btn {
  width: 37px;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  user-select: none;
  cursor: pointer;
}
.pagination_waiting .pagination__btn {
  opacity: 0.5;
}
.pagination__btn_disabled {
  pointer-events: none;
  --button-color: #ccc;
}
.pagination__btn_arrow-left,
.pagination__btn_arrow-right {
  position: relative;
}
.pagination__btn_arrow-left:before,
.pagination__btn_arrow-right:before,
.pagination__btn_arrow-left:after,
.pagination__btn_arrow-right:after {
  content: '';
  display: block;
  position: absolute;
  left: 50%;
  top: 50%;
  width: 9px;
  height: 9px;
  border: 2px solid var(--button-color);
  border-bottom: none;
  border-right: none;
}
.pagination__btn_arrow-left:after,
.pagination__btn_arrow-right:after {
  display: none;
}
.pagination__btn_arrow-left:before,
.pagination__btn_arrow-left:after {
  transform: translate3d(-50%, -50%, 0) rotate(-45deg);
}
.pagination__btn_arrow-right:before,
.pagination__btn_arrow-right:after {
  transform: translate3d(-50%, -50%, 0) rotate(135deg);
}
.pagination__btn_arrow-left-double:after {
  display: block;
  margin-left: 7px;
}
.pagination__btn_arrow-right-double:after {
  display: block;
  margin-left: -7px;
}
.pagination__input {
  width: 100px;
  height: 38px;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #d9d9d9;
  border-top: none;
  border-bottom: none;
  background: var(--sand_100);
  margin: 1px 0;
}
.pagination_waiting .pagination__input {
  opacity: 0.5;
}
.pagination__input input {
  width: 100%;
  height: calc(100% - 2px);
  border: none;
  margin: 1px 0;
  padding: 0;
  outline: none;
  text-align: center;
  background: none;
  font-weight: 500;
  font-size: 16px;
  line-height: 19px;
}
.pagination__page-indicator {
  font-weight: 500;
  font-size: 16px;
  line-height: 19px;
  flex: 1;
  user-select: none;
}
.pagination__page-indicator span {
  font-weight: normal;
  opacity: 0.4;
}
.pagination__page-size {
  min-width: 150px;
  padding-left: 16px;
  box-sizing: content-box;
}
.pagination__page-size .select__list {
  padding-right: 0;
}
