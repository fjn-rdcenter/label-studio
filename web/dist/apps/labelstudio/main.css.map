@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-Regular.ttf") format("truetype");
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-SemiBold.ttf") format("truetype");
  font-weight: 500;
  font-style: normal;
  font-display: swap;
}
body {
  font-family: 'Figtree', sans-serif !important;
  --sand_900: #12110d;
  --sand_800: #262522;
  --sand_700: #45433e;
  --sand_600: #6b6860;
  --sand_500: #a49f95;
  --sand_400: #cac5b8;
  --sand_300: #e1ded5;
  --sand_200: #f0efeb;
  --sand_100: #f9f8f6;
  --sand_0: #fdfdfc;
  --grape_0: #f0f3fe;
  --grape_100: #d4dbfb;
  --grape_500: #566fcf;
  --grape_600: #576cc1;
  --grape_700: #4c5fa9;
  --grape_800: #37447a;
  --kale_0: #f4f9f9;
  --kale_400: #57b7ab;
  --plum_500: #cc6fbe;
  --plum_400: #e37bd3;
  --plum_100: #f7d6f2;
  --plum_0: #fbf2fc;
  --persimmon_300: #ff9f89;
  --persimmon_400: #ff7557;
  --canteloupe_0: #fff6ef;
  --canteloupe_100: #ffe4d0;
  --canteloupe_400: #ffa663;
  --canteloupe_500: #e69559;
  --canteloupe_600: #cc854f;
  --canteloupe_700: #b37445;
  --red_1: #fff1f0;
  --red_3: #ffccc7;
  --red_7: #cf1322;
  --red_10: #5c0011;
  --primary_link: #566fcf;
  --danger_color: var(--red_7);
}
.simple-settings {
  width: 42rem;
}
.simple-settings h1,
.annotation-settings h1,
.general-settings h1,
.storage-settings h1,
.webhook h1 {
  margin-bottom: 0.5rem;
  font-weight: 500;
  margin-top: 0;
  font-size: 1.75rem;
}
.settings-wrapper {
  --column-count: 1;
  border: 1px solid var(--sand_300);
  border-radius: 0.5rem;
  padding: 1.5rem;
  width: 40rem;
}
.settings-wrapper + .settings-wrapper,
.settings-wrapper + .form-wrapper {
  margin-top: 1.5rem;
}
.settings-wrapper h3 {
  margin: 0 0 0.5rem;
  font-weight: 500;
}
.settings-wrapper__header {
  font-weight: 500;
  font-size: 1.5rem;
  margin-bottom: 0;
}
.general-settings {
  display: flex;
}
.general-settings .heidy-tip {
  margin: 0 0 0 40px;
  max-width: 500px;
}
.general-settings .label__text {
  padding: 0;
}
.general-settings .radio-group__buttons .label__content {
  padding: 0 4px;
}
.workspace-placeholder__badge-wrapper {
  display: flex;
  margin-bottom: 8px;
  line-height: normal;
}
.workspace-placeholder__title {
  font-size: 0.875rem;
  color: var(--sand_900);
  font-weight: 500;
}
.settings-caption {
  color: var(--sand_700);
  font-size: 12px;
  font-style: normal;
  font-weight: 400;
  line-height: 16px;
  letter-spacing: 0.4px;
}
.settings-caption a {
  color: var(--primary_link);
  font-size: 12px;
  font-style: normal;
  font-weight: 500;
  line-height: 16px;
  letter-spacing: 0.4px;
}
.settings-caption a:hover {
  text-decoration: underline;
}
.disabled-field {
  display: flex;
  align-items: flex-start;
}
.disabled-field p {
  padding: 0;
  margin: 0;
}
.disabled-field p a {
  color: var(--primary_link);
  font-size: 14px;
  font-style: normal;
  font-weight: 500;
  line-height: 16px;
  letter-spacing: 0.4px;
}
.disabled-field p a:hover {
  text-decoration: underline;
}
.disabled-field__label {
  margin-top: 5px;
}
.disabled-field input {
  margin-top: 5px;
}
.disabled-field__title {
  font-size: 16px;
  line-height: 22px;
  font-weight: 500;
  padding: 0 16px;
  height: 22px;
  display: flex;
  margin-bottom: 4px;
  align-items: center;
}
.disabled-field__description {
  margin-top: 5px;
  font-size: 14px;
  line-height: 22px;
  color: rgba(0,0,0,0.4);
  font-weight: 500;
  padding: 0 16px;
  height: 22px;
  display: flex;
  margin-bottom: 4px;
}
.annotation-settings__wrapper {
  width: 488px;
}
