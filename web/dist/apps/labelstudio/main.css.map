@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-Regular.ttf") format("truetype");
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-SemiBold.ttf") format("truetype");
  font-weight: 500;
  font-style: normal;
  font-display: swap;
}
body {
  font-family: 'Figtree', sans-serif !important;
  --sand_900: #12110d;
  --sand_800: #262522;
  --sand_700: #45433e;
  --sand_600: #6b6860;
  --sand_500: #a49f95;
  --sand_400: #cac5b8;
  --sand_300: #e1ded5;
  --sand_200: #f0efeb;
  --sand_100: #f9f8f6;
  --sand_0: #fdfdfc;
  --grape_0: #f0f3fe;
  --grape_100: #d4dbfb;
  --grape_500: #566fcf;
  --grape_600: #576cc1;
  --grape_700: #4c5fa9;
  --grape_800: #37447a;
  --kale_0: #f4f9f9;
  --kale_400: #57b7ab;
  --plum_500: #cc6fbe;
  --plum_400: #e37bd3;
  --plum_100: #f7d6f2;
  --plum_0: #fbf2fc;
  --persimmon_300: #ff9f89;
  --persimmon_400: #ff7557;
  --canteloupe_0: #fff6ef;
  --canteloupe_100: #ffe4d0;
  --canteloupe_400: #ffa663;
  --canteloupe_500: #e69559;
  --canteloupe_600: #cc854f;
  --canteloupe_700: #b37445;
  --red_1: #fff1f0;
  --red_3: #ffccc7;
  --red_7: #cf1322;
  --red_10: #5c0011;
  --primary_link: #566fcf;
  --danger_color: var(--red_7);
}
.radio-group {
  --radius: 8px;
  --padding: 4px;
  --font-size: 16px;
  --button-padding: 0 10px;
  --button-checked-shadow: 0px 1px 0px rgba(0,0,0,0.1), 0px 0px 0px 1px rgba(0,0,0,0.02), 0px 5px 10px rgba(0,0,0,0.15);
  border-radius: var(--radius);
  padding: var(--padding);
  background: var(--sand_100);
  border: 1px solid var(--sand_300);
  box-sizing: border-box;
}
.radio-group__buttons {
  height: calc(var(--height) - calc(var(--padding) * 2));
  display: grid;
  grid-auto-columns: 1fr;
  grid-auto-flow: column;
}
.radio-group_simple .radio-group__buttons {
  all: unset;
  display: inline-block;
  margin-bottom: 16px;
  margin-top: 8px;
}
.radio-group_horizontal .radio-group__buttons {
  display: grid;
  grid-auto-columns: min-content;
  column-gap: 16px;
  align-items: center;
  grid-auto-flow: column;
  margin: 0;
}
.radio-group .label__text {
  font-weight: 500;
}
.radio-group .label__text:before {
  content: '';
  background: var(--sand_0);
  border-radius: 100%;
  border: 1px solid var(--sand_300);
  display: inline-block;
  width: 1.4em;
  height: 1.4em;
  position: relative;
  top: -10px;
  margin-right: 0.25rem;
  vertical-align: top;
  cursor: pointer;
  text-align: center;
  transition: all 200ms ease;
}
.radio-group input[type=radio] {
  display: none;
}
.radio-group__button {
  display: flex;
  opacity: 0.6;
  padding: var(--button-padding);
  cursor: pointer;
  font-weight: 500;
  position: relative;
  text-align: center;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size);
  border-radius: calc(var(--radius) - var(--padding));
  height: calc(var(--height) - calc(var(--padding) * 2));
}
.radio-group__button_checked {
  opacity: 1;
  background-color: var(--sand_0);
  box-shadow: var(--button-checked-shadow);
}
.radio-group__button_checked .label__text:before {
  background-color: var(--sand_0);
  box-shadow: inset 0 0 0 4px var(--grape_500);
}
.radio-group__button_disabled {
  cursor: not-allowed;
}
.radio-group__button_disabled .label__text {
  font-weight: 500;
}
.radio-group__button_disabled .label__text:before {
  background: var(--sand_200);
}
.radio-group_simple .radio-group__button {
  all: unset;
  display: block;
  margin-bottom: 0.5rem !important;
}
.radio-group_horizontal .radio-group__button {
  margin: 0;
}
.radio-group__input {
  top: 0;
  left: 0;
  opacity: 0;
  width: 100%;
  height: 100%;
  position: absolute;
}
.radio-group_size_large {
  --height: 40px;
  --radius: 8px;
}
.radio-group_size_compact {
  --height: 32px;
  --radius: 8px;
}
.radio-group_size_small {
  --height: 24px;
  --radius: 4px;
  --padding: 2px;
  --font-size: 12px;
  --button-padding: 0 5px;
  --button-checked-shadow: 0px 1px 0px rgba(0,0,0,0.1), 0px 0px 0px 1px rgba(0,0,0,0.02), 0px 2px 4px rgba(0,0,0,0.15);
}
.radio-group_simple {
  --height: auto;
  all: unset;
  display: block;
}
