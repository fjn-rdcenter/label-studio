@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-Regular.ttf") format("truetype");
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-SemiBold.ttf") format("truetype");
  font-weight: 500;
  font-style: normal;
  font-display: swap;
}
body {
  font-family: 'Figtree', sans-serif !important;
  --sand_900: #12110d;
  --sand_800: #262522;
  --sand_700: #45433e;
  --sand_600: #6b6860;
  --sand_500: #a49f95;
  --sand_400: #cac5b8;
  --sand_300: #e1ded5;
  --sand_200: #f0efeb;
  --sand_100: #f9f8f6;
  --sand_0: #fdfdfc;
  --grape_0: #f0f3fe;
  --grape_100: #d4dbfb;
  --grape_500: #566fcf;
  --grape_600: #576cc1;
  --grape_700: #4c5fa9;
  --grape_800: #37447a;
  --kale_0: #f4f9f9;
  --kale_400: #57b7ab;
  --plum_500: #cc6fbe;
  --plum_400: #e37bd3;
  --plum_100: #f7d6f2;
  --plum_0: #fbf2fc;
  --persimmon_300: #ff9f89;
  --persimmon_400: #ff7557;
  --canteloupe_0: #fff6ef;
  --canteloupe_100: #ffe4d0;
  --canteloupe_400: #ffa663;
  --canteloupe_500: #e69559;
  --canteloupe_600: #cc854f;
  --canteloupe_700: #b37445;
  --red_1: #fff1f0;
  --red_3: #ffccc7;
  --red_7: #cf1322;
  --red_10: #5c0011;
  --primary_link: #566fcf;
  --danger_color: var(--red_7);
}
.export-page__finish {
  width: 135px;
}
.export-page__recent {
  display: grid;
  grid-auto-flow: rows;
}
.export-page__footer {
  margin: 0 -32px -32px;
  padding: 32px 40px 32px;
  position: sticky;
  bottom: -40px;
  background-color: var(--sand_0);
  border-radius: 5px;
}
.formats {
  color: var(--sand_700);
  font-size: 16px;
}
.formats__list {
  margin: 10px -7px;
}
.formats a {
  color: var(--primary_link);
  text-decoration: underline;
}
.formats__item {
  padding: 10px 9px 10px 38px;
  border-radius: 4px;
  position: relative;
  pointer-events: none;
}
.formats__item_active {
  cursor: pointer;
  pointer-events: all;
}
.formats__item_active:hover:not(.formats__item_selected) {
  background-color: var(--grape_0);
}
.formats__item_selected {
  pointer-events: none;
  background-color: var(--grape_0);
  border: 1px solid var(--grape_500);
}
.formats__item:not(.formats__item_active) {
  opacity: 0.3;
}
.formats__item::before,
.formats__item::after {
  top: 50%;
  left: 10px;
  width: 18px;
  height: 18px;
  content: '';
  display: block;
  position: absolute;
  border-radius: 100%;
  transform: translate(0, -50%);
}
.formats__item::before {
  box-shadow: 0 0 0 0.5px rgba(0,0,0,0.5);
}
.formats__item_selected::after {
  left: 12px;
  width: 14px;
  height: 14px;
  background-color: #566fcf;
}
.formats__name {
  display: flex;
  font-weight: 500;
  justify-content: space-between;
}
.formats__tag {
  font-size: 12px;
  padding: 2px 5px;
  border-radius: 2px;
  font-weight: 400;
  background-color: rgba(86,111,207,0.1);
}
.formats__description {
  font-size: 14px;
  opacity: 0.7;
}
