@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-Regular.ttf") format("truetype");
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-SemiBold.ttf") format("truetype");
  font-weight: 500;
  font-style: normal;
  font-display: swap;
}
body {
  font-family: 'Figtree', sans-serif !important;
  --sand_900: #12110d;
  --sand_800: #262522;
  --sand_700: #45433e;
  --sand_600: #6b6860;
  --sand_500: #a49f95;
  --sand_400: #cac5b8;
  --sand_300: #e1ded5;
  --sand_200: #f0efeb;
  --sand_100: #f9f8f6;
  --sand_0: #fdfdfc;
  --grape_0: #f0f3fe;
  --grape_100: #d4dbfb;
  --grape_500: #566fcf;
  --grape_600: #576cc1;
  --grape_700: #4c5fa9;
  --grape_800: #37447a;
  --kale_0: #f4f9f9;
  --kale_400: #57b7ab;
  --plum_500: #cc6fbe;
  --plum_400: #e37bd3;
  --plum_100: #f7d6f2;
  --plum_0: #fbf2fc;
  --persimmon_300: #ff9f89;
  --persimmon_400: #ff7557;
  --canteloupe_0: #fff6ef;
  --canteloupe_100: #ffe4d0;
  --canteloupe_400: #ffa663;
  --canteloupe_500: #e69559;
  --canteloupe_600: #cc854f;
  --canteloupe_700: #b37445;
  --red_1: #fff1f0;
  --red_3: #ffccc7;
  --red_7: #cf1322;
  --red_10: #5c0011;
  --primary_link: #566fcf;
  --danger_color: var(--red_7);
}
.main-menu {
  flex: 1;
  margin: 0;
  padding: 8px;
  display: flex;
  flex-direction: column;
  list-style-type: none;
  max-width: 100%;
  box-sizing: border-box;
  background: var(--sand_0);
  border-radius: 4px;
}
.main-menu__item {
  height: 48px;
  display: flex;
  cursor: pointer;
  padding: 0 13px;
  border-radius: 0.5rem;
  align-items: center;
  box-sizing: border-box;
  color: var(--sand_600);
  font-size: 1rem;
  white-space: nowrap;
  text-decoration: none;
  cursor: pointer;
}
.main-menu__item-icon {
  margin-right: 10px;
  object-fit: contain;
  opacity: 0.5;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24px;
}
.main-menu__item-beta {
  background-color: var(--plum_500);
  color: var(--plum_0);
  font-size: 12px;
  font-style: normal;
  font-weight: 500;
  line-height: 16px;
  margin-left: 8px;
  padding: 2px 8px;
  border-radius: 12px;
}
.main-menu__item_look_danger {
  color: var(--red_7);
}
.main-menu__item:not(.main-menu__item_look_danger):hover {
  color: var(--sand_900);
}
.main-menu__item:not(.main-menu__item_active):hover {
  color: var(--grape_700);
  background: var(--grape_0);
}
.main-menu__item_active {
  color: var(--sand_900);
  background-color: var(--sand_200);
  font-weight: 500;
}
.main-menu__item_active:not(.sidebar__pin) {
  pointer-events: none;
}
.main-menu__item:hover .main-menu__item-icon,
.main-menu__item_active .main-menu__item-icon {
  opacity: 1;
}
.main-menu__item_dangerous {
  color: var(--red_7);
}
.main-menu__item_dangerous:hover {
  color: var(--red_7) !important;
  background-color: var(--red_1) !important;
}
.main-menu__spacer {
  flex: 1;
}
.main-menu__divider {
  height: 1px;
  margin: 8px 0;
  background-color: rgba(0,0,0,0.1);
}
.main-menu_size_compact {
  background: var(--sand_0);
}
.main-menu_size_compact .main-menu__item,
.main-menu_size_medium .main-menu__item {
  height: 32px;
  font-size: 16px;
}
.main-menu_size_small .main-menu__item {
  height: 24px;
  font-size: 14px;
  padding: 0 10px;
}
.main-menu_collapsed {
  padding: 0.5rem;
}
.main-menu_collapsed .main-menu__item {
  border-radius: 0.25rem;
}
.main-menu_contextual {
  box-shadow: 0px 1px 2px rgba(38,38,38,0.3), 0px 1px 3px 1px rgba(38,38,38,0.15);
  border-radius: 4px;
}
.main-menu__item_dangerous {
  color: #cf1322;
}
.main-menu__item_dangerous:hover {
  color: #cf1322;
  background-color: rgba(207,19,34,0.08);
}
.main-menu_contextual .main-menu__item {
  height: 32px;
  padding: 16px 8px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-radius: 4px;
  cursor: pointer;
}
.main-menu_contextual .main-menu__item:hover {
  background-color: var(--grape_0);
}
.main-menu_contextual .main-menu__item_dangerous {
  color: #cf1322;
}
.main-menu_contextual .main-menu__item_dangerous:hover {
  color: #cf1322;
  background-color: rgba(207,19,34,0.08);
}
.main-menu:first-child {
  padding-top: 8px;
}
.main-menu:last-child {
  padding-bottom: 8px;
  background: var(--sand_100);
}
.menu-group__title {
  padding: 4px 10px;
  font-size: 14px;
  color: var(--sand_600);
}
.menu-group__list {
  padding: 0;
  margin-left: 10px;
  list-style-type: none;
}
