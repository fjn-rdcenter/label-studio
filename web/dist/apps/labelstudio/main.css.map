@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-Regular.ttf") format("truetype");
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-SemiBold.ttf") format("truetype");
  font-weight: 500;
  font-style: normal;
  font-display: swap;
}
body {
  font-family: 'Figtree', sans-serif !important;
  --sand_900: #12110d;
  --sand_800: #262522;
  --sand_700: #45433e;
  --sand_600: #6b6860;
  --sand_500: #a49f95;
  --sand_400: #cac5b8;
  --sand_300: #e1ded5;
  --sand_200: #f0efeb;
  --sand_100: #f9f8f6;
  --sand_0: #fdfdfc;
  --grape_0: #f0f3fe;
  --grape_100: #d4dbfb;
  --grape_500: #566fcf;
  --grape_600: #576cc1;
  --grape_700: #4c5fa9;
  --grape_800: #37447a;
  --kale_0: #f4f9f9;
  --kale_400: #57b7ab;
  --plum_500: #cc6fbe;
  --plum_400: #e37bd3;
  --plum_100: #f7d6f2;
  --plum_0: #fbf2fc;
  --persimmon_300: #ff9f89;
  --persimmon_400: #ff7557;
  --canteloupe_0: #fff6ef;
  --canteloupe_100: #ffe4d0;
  --canteloupe_400: #ffa663;
  --canteloupe_500: #e69559;
  --canteloupe_600: #cc854f;
  --canteloupe_700: #b37445;
  --red_1: #fff1f0;
  --red_3: #ffccc7;
  --red_7: #cf1322;
  --red_10: #5c0011;
  --primary_link: #566fcf;
  --danger_color: var(--red_7);
}
.form {
  width: 100%;
  display: block;
}
.form__row {
  display: grid;
  justify-items: stretch;
  justify-content: space-between;
  grid-template-columns: repeat(var(--column-count, 5), 1fr);
  grid-column-gap: 8px;
  grid-row-gap: var(--row-gap, 8px);
}
.form__row:not(:first-child) {
  margin-top: 12px;
}
.form__row description {
  font-size: 0.875rem;
}
.form__submit {
  display: flex;
  margin-top: 32px;
  align-items: center;
  justify-content: space-between;
}
.form__submit + .inline-error {
  margin-top: 32px;
}
.form__submit_size_small {
  margin-top: 16px;
}
.form__info {
  display: flex;
  align-items: center;
  color: #d00;
  font-size: 14px;
  line-height: 22px;
}
.form__info_valid {
  color: rgba(0,0,0,0.4);
}
.form__column {
  display: grid;
  grid-auto-flow: column;
  align-items: flex-start;
}
.input:not(.input_ghost):focus,
.textarea:not(.textarea_ghost):focus,
.counter:not(.counter_ghost):focus,
.select__list:not(.select__list_ghost):focus,
.input_focused,
.textarea_focused,
.counter_focused,
.select__list_focused {
  outline: none;
  box-shadow: 0px 0px 0px 6px var(--grape_100), inset 0px -1px 0px rgba(0,0,0,0.1), inset 0px 0px 0px 1px rgba(0,0,0,0.15), inset 0px 0px 0px 1px rgba(86,111,207,0.2);
  border-color: var(--grape_100);
}
.form-indicator {
  font-weight: 500;
}
.form-indicator__item_type_success {
  color: #59aa05;
}
.form-indicator__item_type_fail {
  color: var(--danger_color);
}
