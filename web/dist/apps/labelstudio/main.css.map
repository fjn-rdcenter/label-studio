@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-Regular.ttf") format("truetype");
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-SemiBold.ttf") format("truetype");
  font-weight: 500;
  font-style: normal;
  font-display: swap;
}
body {
  font-family: 'Figtree', sans-serif !important;
  --sand_900: #12110d;
  --sand_800: #262522;
  --sand_700: #45433e;
  --sand_600: #6b6860;
  --sand_500: #a49f95;
  --sand_400: #cac5b8;
  --sand_300: #e1ded5;
  --sand_200: #f0efeb;
  --sand_100: #f9f8f6;
  --sand_0: #fdfdfc;
  --grape_0: #f0f3fe;
  --grape_100: #d4dbfb;
  --grape_500: #566fcf;
  --grape_600: #576cc1;
  --grape_700: #4c5fa9;
  --grape_800: #37447a;
  --kale_0: #f4f9f9;
  --kale_400: #57b7ab;
  --plum_500: #cc6fbe;
  --plum_400: #e37bd3;
  --plum_100: #f7d6f2;
  --plum_0: #fbf2fc;
  --persimmon_300: #ff9f89;
  --persimmon_400: #ff7557;
  --canteloupe_0: #fff6ef;
  --canteloupe_100: #ffe4d0;
  --canteloupe_400: #ffa663;
  --canteloupe_500: #e69559;
  --canteloupe_600: #cc854f;
  --canteloupe_700: #b37445;
  --red_1: #fff1f0;
  --red_3: #ffccc7;
  --red_7: #cf1322;
  --red_10: #5c0011;
  --primary_link: #566fcf;
  --danger_color: var(--red_7);
}
.ls-panel {
  display: none;
}
.wizard {
  flex: 1;
  min-height: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
}
.sidebar-menu__content > .wizard {
  height: calc(100% + 64px);
  margin: -32px -40px;
}
.wizard > .configure {
  flex: 1;
  min-height: 0;
  display: flex;
  align-items: stretch;
}
.wizard > .configure > * {
  flex: 50%;
}
.wizard .configure__container {
  display: flex;
  flex-direction: column;
  padding: 16px 11px 16px 20px;
  overflow-y: scroll;
  background-color: var(--sand_0);
}
.wizard .configure__container::-webkit-scrollbar {
  width: 5px;
}
.wizard .configure__container::-webkit-scrollbar-track {
  background: none;
}
.templates-list {
  display: grid;
  height: 100%;
  grid-template: 1fr auto/224px auto;
}
.templates-list__sidebar {
  padding: 16px 8px 16px 32px;
}
.templates-list__sidebar h3:not(:first-child) {
  margin-top: 2em;
}
.templates-list__sidebar .templates-list__custom-template {
  margin-top: 20px;
  padding-left: 8px;
  font-weight: 500;
  border: none;
  color: var(--grape_500);
  background: none;
  width: 100%;
  text-align: left;
}
.templates-list__sidebar ul {
  padding: 0;
  list-style: none;
  display: flex;
  flex-direction: column;
}
.templates-list__group {
  margin: 0 0 4px;
  padding: 4px 8px;
  border-radius: 4px;
  cursor: pointer;
  color: #595959;
  font-weight: 500;
  line-height: 24px;
  display: flex;
  align-items: center;
}
.templates-list__group:hover {
  background-color: #f4f4f4;
}
.templates-list__group_active {
  color: #000;
  background-color: #f0f0f0;
}
.templates-list__group svg {
  margin-left: auto;
  padding-left: 16px;
  width: 24px;
  flex-shrink: 0;
}
.templates-list main {
  position: relative;
  flex-grow: 1;
  overflow-y: auto;
  height: 100%;
}
.templates-list main ul {
  display: grid;
  flex-wrap: wrap;
  padding: 0;
  margin: 16px 8px;
  grid-template-columns: repeat(auto-fill, 276px);
  grid-auto-columns: 276px;
  grid-gap: 16px;
}
.templates-list__template {
  display: flex;
  flex-direction: column;
  border-radius: 4px;
  cursor: pointer;
  position: relative;
  width: 276px;
  border: 1px solid #d9d9d9;
  box-sizing: content-box;
}
.templates-list__template_active,
.templates-list__template:hover {
  box-shadow: 0px 0px 0 2px var(--primary_link);
}
.templates-list__template:hover {
  opacity: 0.9;
}
.templates-list__template h3 {
  margin: 0;
  padding: 12px;
  font-size: 14px;
  font-weight: 500;
  border-top: 1px solid #d9d9d9;
}
.templates-list__template img {
  width: 276px;
  height: 204px;
  object-fit: cover;
  border-radius: 4px 4px 0 0;
}
.templates-list footer,
.templates-list .modal__footer {
  grid-column: 1/span 2;
  padding: 16px 32px;
  font-size: 14px;
  background: var(--sand_100);
  box-shadow: inset 0px 1px 0px rgba(0,0,0,0.05);
  text-align: center;
}
.templates-list footer a,
.templates-list .modal__footer a {
  color: var(--primary_link);
}
.templates-list__info-icon {
  margin-right: 8px;
  vertical-align: -5px;
  height: 20px;
}
.wizard a.back {
  align-self: center;
  width: 220px;
  height: 30px;
}
.wizard a.back::before {
  content: '\2190';
  margin-right: 8px;
}
.wizard .project__create {
  display: none;
}
.wizard .project__create p {
  margin: 0;
}
.wizard h1 {
  font-size: 1.75rem;
  width: 100%;
  display: flex;
}
.wizard h1 a[name=config] {
  margin-left: auto;
  font-size: 1rem;
  font-weight: 400;
  background: #ccc;
}
.wizard h1 a[name=config]:hover {
  background: #2593fc;
}
.wizard h1 a[name=config]:hover::before {
  content: "Advanced! ";
}
.wizard a.button,
.wizard button,
.wizard input[type=button] {
  line-height: 1;
}
.configure__container > header {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-bottom: 16px;
}
.configure__editor {
  display: flex;
  flex: 1;
  overflow-y: auto;
}
.configure__editor::-webkit-scrollbar {
  width: 6px;
  height: 6px;
  background-color: #f5f5f5;
}
.configure__editor::-webkit-scrollbar-thumb {
  background-color: #bfbfbf;
}
.configure__tags-link {
  margin: 0;
  line-height: 21px;
  margin-top: -6px;
}
.configure__tags-link a {
  color: var(--primary_link);
}
.configure__container > header .toggle-items {
  margin-left: auto;
}
.wizard .configure__code {
  overflow-x: hidden;
}
.wizard .configure__code textarea,
.wizard .configure__code :global(.react-codemirror2) {
  flex: 1;
  font-family: monospace;
}
.wizard .configure__code textarea :global(.CodeMirror),
.wizard .configure__code :global(.react-codemirror2) :global(.CodeMirror) {
  height: 100%;
}
.wizard .configure__code,
.wizard .configure__visual {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.wizard .configure__visual > * {
  border-top: 1px solid var(--sand_300);
  padding-top: 16px;
  margin-bottom: 16px;
}
.wizard .configure__object h4 {
  margin-bottom: 8px;
}
.wizard .configure__object > p {
  line-height: 32px;
}
.wizard .configure__object > p.configure__object-error {
  line-height: 22px;
  margin-top: 8px;
  color: #771b04;
}
.wizard .configure__object input {
  margin-left: 8px;
  padding: 4px 8px;
  line-height: 1.4em;
}
.wizard .configure__object select {
  padding: 4px 8px;
  font: inherit;
  border-color: #dededf;
}
.wizard .configure__enable_manual_columns {
  border-bottom: 1px dashed #888;
  width: fit-content;
  cursor: pointer;
}
.wizard .configure__enable_manual_columns:hover {
  opacity: 0.8;
}
.wizard .configure__labels {
  display: flex;
  max-height: 200px;
}
.wizard .configure__add-labels {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  flex: 1;
}
.wizard .configure__add-labels textarea {
  flex-grow: 1;
  margin: 8px 0;
  border-color: #dededf;
  font: inherit;
}
.wizard .configure__visual h4 {
  margin: 0;
  font-weight: 500;
}
/*** Configure Labels ***/
.wizard .configure__current-labels {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow-x: hidden;
  margin-right: 8px;
}
.wizard .configure__current-labels h3 {
  font-size: 16px;
  margin: 0 32px 7px;
}
.wizard .configure__labels ul {
  overflow-y: scroll;
  padding: 0 2em;
  margin: 0;
  list-style: none;
  min-width: 140px;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  flex: 1;
}
.wizard .configure__labels ul::-webkit-scrollbar {
  width: 6px;
  height: 6px;
  background-color: #f5f5f5;
}
.wizard .configure__labels ul::-webkit-scrollbar-thumb {
  background-color: #bfbfbf;
}
.wizard .configure__labels ul .configure__label {
  display: flex;
  align-items: stretch;
  position: relative;
}
.wizard .configure__labels ul .configure__label:not(:first-child) {
  margin-top: 8px;
}
.wizard .configure__labels ul .configure__label_choice label {
  display: none;
}
.wizard .configure__labels ul .configure__label_choice span {
  background: rgba(0,0,0,0.05);
}
.wizard .configure__labels ul .configure__label label {
  width: 0px;
  cursor: pointer;
}
.wizard .configure__labels ul .configure__label label::before {
  content: "";
  position: absolute;
  width: 100%;
  height: 100%;
  background: inherit;
  opacity: 0.2;
  left: 0;
  right: 0;
  border-radius: 0 4px 4px 0;
}
.wizard .configure__labels ul .configure__label label::after {
  position: absolute;
  left: -4px;
  width: 4px;
  content: "";
  height: 100%;
  background: inherit;
  border-radius: 3px 0 0 3px;
  transition: 0.1s all;
  will-change: width, left;
}
.wizard .configure__labels ul .configure__label .configure__label-color {
  width: 1px;
  padding: 0;
  border: 0;
  position: absolute;
  opacity: 0;
}
.wizard .configure__labels ul .configure__label span {
  padding: 0 8px;
  overflow-x: hidden;
  word-break: break-word;
}
.wizard .configure__labels ul .configure__label .configure__delete-label {
  min-width: 0;
  border: 0;
  border-radius: 0 4px 4px 0;
  background: none;
  cursor: pointer;
  padding: 2px 6px;
  font-size: 12px;
  position: absolute;
  top: 0;
  left: 100%;
  height: 100%;
  opacity: 0.3;
}
.wizard .configure__labels ul .configure__label .configure__delete-label:hover {
  background: rgba(255,0,0,0.133);
  opacity: 1;
}
.wizard .configure__labels ul .configure__label:hover {
  background: rgba(0,0,0,0.05);
}
.wizard .configure__labels ul .configure__label:hover label::before {
  border-radius: 0;
}
.wizard .configure__labels ul .configure__label:hover label::after {
  width: 12px;
  left: -12px;
}
.wizard ul.configure__settings {
  padding: 0;
}
.wizard ul.configure__settings ul {
  padding: 0;
}
.wizard ul.configure__settings li {
  list-style: none;
  margin: 12px 0;
}
.wizard ul.configure__settings label {
  cursor: pointer;
}
.wizard ul.configure__settings input[type=checkbox] {
  margin-right: 8px;
}
.wizard ul.configure__settings input[type=text],
.wizard ul.configure__settings select {
  font: inherit;
  line-height: 1.2em;
  padding: 4px 8px;
  border-radius: 4px;
  border: 1px solid var(--sand_300);
}
.wizard .configure__preview {
  flex-grow: 10;
  min-width: 500px;
  padding: 16px 16px 0;
  overflow-y: auto;
  border-left: 1px solid var(--sand_300);
  background-color: var(--sand_100);
  display: flex;
  flex-direction: column;
}
.wizard .configure__preview::-webkit-scrollbar {
  width: 6px;
  height: 6px;
  background-color: #f5f5f5;
}
.wizard .configure__preview::-webkit-scrollbar-thumb {
  background-color: #bfbfbf;
}
.wizard .configure__preview h3 {
  margin: 8px 0 16px;
  font-size: 16px;
}
.wizard .configure__preview iframe {
  display: block;
  width: 100%;
  height: 100%;
}
.wizard .configure__preview-ui {
  flex: 1;
  min-height: 0;
}
.wizard .configure__preview-error {
  color: #771b04;
  border: 1px solid #e68a6e;
  background-color: #ffc1ae;
  padding: 10px 15px;
  border-radius: 3px;
  margin-bottom: 16px;
  white-space: pre-line;
}
.wizard .configure__preview-error h2 {
  font-size: 16px;
}
.wizard .configure__preview .editor > .common {
  flex: 1;
  max-width: 100%;
}
.wizard .configure__preview :global(.lsf-main-view__annotation) {
  padding: 0;
}
div[class^=App_menu]>div {
  width: 100%;
}
