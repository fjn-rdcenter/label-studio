@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-Regular.ttf") format("truetype");
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-SemiBold.ttf") format("truetype");
  font-weight: 500;
  font-style: normal;
  font-display: swap;
}
body {
  font-family: 'Figtree', sans-serif !important;
  --sand_900: #12110d;
  --sand_800: #262522;
  --sand_700: #45433e;
  --sand_600: #6b6860;
  --sand_500: #a49f95;
  --sand_400: #cac5b8;
  --sand_300: #e1ded5;
  --sand_200: #f0efeb;
  --sand_100: #f9f8f6;
  --sand_0: #fdfdfc;
  --grape_0: #f0f3fe;
  --grape_100: #d4dbfb;
  --grape_500: #566fcf;
  --grape_600: #576cc1;
  --grape_700: #4c5fa9;
  --grape_800: #37447a;
  --kale_0: #f4f9f9;
  --kale_400: #57b7ab;
  --plum_500: #cc6fbe;
  --plum_400: #e37bd3;
  --plum_100: #f7d6f2;
  --plum_0: #fbf2fc;
  --persimmon_300: #ff9f89;
  --persimmon_400: #ff7557;
  --canteloupe_0: #fff6ef;
  --canteloupe_100: #ffe4d0;
  --canteloupe_400: #ffa663;
  --canteloupe_500: #e69559;
  --canteloupe_600: #cc854f;
  --canteloupe_700: #b37445;
  --red_1: #fff1f0;
  --red_3: #ffccc7;
  --red_7: #cf1322;
  --red_10: #5c0011;
  --primary_link: #566fcf;
  --danger_color: var(--red_7);
}
.inline-error {
  width: 100%;
  padding: 16px;
  border-radius: 5px;
  box-sizing: border-box;
  background-color: #f8f8f8;
}
.error-message {
  max-width: 100%;
}
.error-message__heidi {
  display: block;
  margin: 32px auto 0;
}
.error-message__title {
  text-transform: uppercase;
  text-align: center;
  font-size: 20px;
  margin: 32px auto;
}
.error-message__detail {
  font-size: 24px;
  font-weight: bold;
  color: var(--red_7);
  margin: 16px 0;
  white-space: pre-line;
  word-break: break-word;
}
.error-message__exception {
  margin: 15px 0;
}
.error-message__stracktrace {
  margin: 16px 0;
  padding: 16px;
  overflow: auto;
  line-height: 26px;
  max-height: 200px;
  white-space: pre;
  border-radius: 5px;
  background-color: #efefef;
  font-family: Monaco, monospace;
}
.error-message__version {
  font-size: 14px;
  font-weight: bold;
  margin: 16px 0;
}
.error-message__validation {
  padding: 0;
  margin: 16px 0;
  list-style-type: none;
  max-height: 300px;
  overflow-y: auto;
}
.error-message__message {
  margin: 5px 0;
  color: #333;
  padding: 0;
  white-space: pre-line;
  word-break: break-word;
}
.error-message__actions {
  display: flex;
  padding: 16px 0 0;
}
.error-message__slack {
  margin-right: auto;
  display: flex;
  align-items: center;
}
.error-message__slack img {
  height: 16px;
  width: 16px;
  margin-right: 8px;
}
