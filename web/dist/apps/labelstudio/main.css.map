@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-Regular.ttf") format("truetype");
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-SemiBold.ttf") format("truetype");
  font-weight: 500;
  font-style: normal;
  font-display: swap;
}
body {
  font-family: 'Figtree', sans-serif !important;
  --sand_900: #12110d;
  --sand_800: #262522;
  --sand_700: #45433e;
  --sand_600: #6b6860;
  --sand_500: #a49f95;
  --sand_400: #cac5b8;
  --sand_300: #e1ded5;
  --sand_200: #f0efeb;
  --sand_100: #f9f8f6;
  --sand_0: #fdfdfc;
  --grape_0: #f0f3fe;
  --grape_100: #d4dbfb;
  --grape_500: #566fcf;
  --grape_600: #576cc1;
  --grape_700: #4c5fa9;
  --grape_800: #37447a;
  --kale_0: #f4f9f9;
  --kale_400: #57b7ab;
  --plum_500: #cc6fbe;
  --plum_400: #e37bd3;
  --plum_100: #f7d6f2;
  --plum_0: #fbf2fc;
  --persimmon_300: #ff9f89;
  --persimmon_400: #ff7557;
  --canteloupe_0: #fff6ef;
  --canteloupe_100: #ffe4d0;
  --canteloupe_400: #ffa663;
  --canteloupe_500: #e69559;
  --canteloupe_600: #cc854f;
  --canteloupe_700: #b37445;
  --red_1: #fff1f0;
  --red_3: #ffccc7;
  --red_7: #cf1322;
  --red_10: #5c0011;
  --primary_link: #566fcf;
  --danger_color: var(--red_7);
}
.modal {
  --transition-duration: 100ms;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 2000;
  display: flex;
  position: fixed;
  align-items: center;
  justify-content: center;
  background-color: rgba(0,0,0,0.3);
  will-change: opacity;
}
.modal_optimize .modal__wrapper {
  will-change: transform;
}
.modal__wrapper {
  width: 100%;
  max-height: 100%;
  padding: 40px 0;
  overflow: auto;
  box-sizing: border-box;
}
.modal__content {
  width: 400px;
  min-width: 400px;
  min-height: 100px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  background-color: var(--sand_0);
  border-radius: 0.5rem;
  box-shadow: 0 10px 30px rgba(0,0,0,0.3);
}
.modal__header {
  display: flex;
  min-height: 40px;
  align-items: center;
  justify-content: space-between;
  padding: 1rem 2rem;
  box-sizing: content-box;
}
.modal__header_divided {
  border-bottom: 1px solid var(--sand_300);
}
.modal__title {
  margin: 0;
  margin-right: auto;
  font-size: 1.75rem;
  font-weight: 500;
}
.modal__body {
  flex: 1;
  padding: 0 2rem 2rem;
  min-height: 0;
  line-height: 140%;
}
.modal__body_bare {
  padding: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
}
.modal__footer {
  padding: 1rem 1.5rem;
  text-align: center;
  font-size: 14px;
  line-height: 22px;
}
.modal__footer a {
  color: var(--grape_600);
  text-decoration: underline;
}
.modal__footer a:hover {
  color: var(--grape_700);
}
.modal__footer:not(.modal__footer_bare) {
  background: var(--sand_100);
  box-shadow: inset 0px 1px 0px var(--sand_300);
}
.modal__close {
  --button-color: var(--primary_link);
  border: none;
  --icon-size: 16px;
}
.modal_fullscreen .modal__content {
  width: calc(100vw - 80px);
  height: calc(100vh - 80px);
}
.modal_visible {
  opacity: 0;
  transition: opacity var(--transition-duration) ease;
}
.modal_visible .modal__wrapper {
  transform: scale(1.05);
  transition: transform var(--transition-duration) ease;
}
.modal.visible {
  opacity: 1;
}
.modal.visible .modal__wrapper {
  transform: none;
}
.modal.before-appear {
  opacity: 0;
}
.modal.before-appear .modal__wrapper {
  transform: scale(1.05);
}
.modal.appear {
  opacity: 1;
}
.modal.appear .modal__wrapper {
  transform: scale(1);
}
.modal.before-disappear {
  opacity: 1;
}
.modal.before-disappear .modal__wrapper {
  transform: scale(1);
}
.modal.disappear {
  opacity: 0;
}
.modal.disappear .modal__wrapper {
  transform: scale(1.05);
}
