@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-Regular.ttf") format("truetype");
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Figtree";
  src: url("/static/fonts/Figtree-SemiBold.ttf") format("truetype");
  font-weight: 500;
  font-style: normal;
  font-display: swap;
}
body {
  font-family: 'Figtree', sans-serif !important;
  --sand_900: #12110d;
  --sand_800: #262522;
  --sand_700: #45433e;
  --sand_600: #6b6860;
  --sand_500: #a49f95;
  --sand_400: #cac5b8;
  --sand_300: #e1ded5;
  --sand_200: #f0efeb;
  --sand_100: #f9f8f6;
  --sand_0: #fdfdfc;
  --grape_0: #f0f3fe;
  --grape_100: #d4dbfb;
  --grape_500: #566fcf;
  --grape_600: #576cc1;
  --grape_700: #4c5fa9;
  --grape_800: #37447a;
  --kale_0: #f4f9f9;
  --kale_400: #57b7ab;
  --plum_500: #cc6fbe;
  --plum_400: #e37bd3;
  --plum_100: #f7d6f2;
  --plum_0: #fbf2fc;
  --persimmon_300: #ff9f89;
  --persimmon_400: #ff7557;
  --canteloupe_0: #fff6ef;
  --canteloupe_100: #ffe4d0;
  --canteloupe_400: #ffa663;
  --canteloupe_500: #e69559;
  --canteloupe_600: #cc854f;
  --canteloupe_700: #b37445;
  --red_1: #fff1f0;
  --red_3: #ffccc7;
  --red_7: #cf1322;
  --red_10: #5c0011;
  --primary_link: #566fcf;
  --danger_color: var(--red_7);
}
.people-list {
  width: 100%;
  min-width: 650px;
  font-size: 16px;
}
.people-list__wrapper {
  border-radius: 4px;
  border: 1px solid var(--sand_300);
  background: var(--sand_0);
}
.people-list__loading {
  width: 100%;
  display: flex;
  min-height: 250px;
  justify-content: center;
  align-items: center;
}
.people-list__users {
  width: 100%;
  text-align: left;
  border-collapse: collapse;
}
.people-list__header {
  font-weight: 500;
  display: flex;
}
.people-list__column,
.people-list__field {
  z-index: 2;
  height: 48px;
  padding: 0 10px;
  border: none;
  color: #000;
  display: flex;
  position: relative;
  align-items: center;
}
.people-list__field.last-activity {
  color: var(--sand_600);
}
.people-list__column {
  font-weight: 500;
  background: none;
}
.people-list__field.avatar,
.people-list__column.avatar {
  width: 28px;
  box-sizing: content-box;
}
.people-list__field.name,
.people-list__column.name {
  flex: 1;
}
.people-list__field.email,
.people-list__column.email {
  width: 200px;
}
.people-list__field.last-activity,
.people-list__column.last-activity {
  width: 160px;
}
.people-list__user {
  cursor: pointer;
  display: flex;
}
.people-list__user:nth-child(odd):not(.people-list__user_active) {
  background-color: var(--sand_100);
}
.people-list__user_active {
  position: relative;
  background-color: var(--sand_0);
}
.people-list__user_active::before,
.people-list__user_active::after {
  top: 0;
  bottom: 0;
  left: -1px;
  content: '';
  display: block;
  position: absolute;
}
.people-list__user_active::after {
  z-index: 1;
  background-color: var(--sand_0);
  width: calc(100% + 22px);
  box-shadow: inset 2px 0 0 var(--grape_500), 1px 0 0 1px var(--sand_300) inset;
}
.people-list__user_active::before {
  z-index: 0;
  height: 100%;
  width: calc(100% + 22px);
}
