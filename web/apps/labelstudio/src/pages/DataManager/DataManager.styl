.datamanager
  height calc(100vh - var(--header-height))
  min-height 0
  overflow hidden

  // hack to change background of selected annotation in LSF inside DM
  #label-studio-dm [class*=Annotations_annotation_selected]
    background: var(--grape_0)

// "Done image" button and its per-physician options
.tasdf-propagation
  display inline-flex
  align-items center
  gap 6px
  font-size 12px

  input[type=number]
    width 52px
    padding 2px 4px
