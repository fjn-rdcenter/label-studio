.members-settings
  padding 0

  &__controls
    margin 16px 0

  &__list
    margin-top 16px

  &__item
    display flex
    align-items center
    gap 16px
    padding 8px 0
    border-bottom 1px solid var(--border_color, #e1e4e9)

  &__email
    flex 1

  &__role
    width 180px

  &__empty
    color var(--grape_400, #88899d)
    margin-top 16px
