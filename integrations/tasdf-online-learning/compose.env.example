# Per-environment knobs for docker-compose.tasdf.yml (compose interpolation, not passed to the app as-is).
# Copy to the label-studio repo root as `.env`, or keep one file per environment:
#   docker compose --env-file deploy-prod.env -f docker-compose.yml -f docker-compose.tasdf.yml up -d
# Secrets (LS_TOKEN, LS_PROJECT_ID, OL_TOKEN) do NOT go here: they go in ${TASDF_DATA_DIR}/tasdf.env.

# Host dir mounted at /data/tasdf-online: baseline.pt, holdout.npz, anchors.npz (optional), tasdf.env, state/.
# Must exist before `up` (compose will not create it).
TASDF_DATA_DIR=./.data/tasdf-online

# UID:GID the container runs as; must be able to write TASDF_DATA_DIR. Linux: `id -u` / `id -g`.
# Docker Desktop (Windows/macOS): any value works. Rootless Docker: 0 (maps to your own user).
TASDF_UID=1000
TASDF_GID=1000

# Host port mapping of :9090. Bare port = all interfaces (dev dashboard from another machine);
# 127.0.0.1:9090 = local only (product: LS reaches the backend over the docker network anyway).
TASDF_PUBLISH=9090

# Leave commented: each overlay sets its own default (CPU: cpu/8, GPU overlay: cuda/0). Uncomment only to override, e.g. TASDF_DEVICE=cuda:1
# TASDF_DEVICE=cpu
TASDF_TORCH_THREADS=4
# TASDF_HOLDOUT_LIMIT=8
# 1 = dev dashboard at :9090/dashboard; product: 0 (not mounted)
TASDF_DASHBOARD=1
# Torch wheel index used at build time (the GPU overlay pins cu128)
TASDF_TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

# --- Typical values per environment -------------------------------------------------------------
# Dev, Windows Docker Desktop : defaults above.
# Linux host, CPU             : TASDF_UID/TASDF_GID = output of `id -u` / `id -g`.
# Linux host, GPU (+ -f docker-compose.tasdf-gpu.yml):
#                               defaults of the GPU overlay apply; only TASDF_DEVICE=cuda:1 to pick another GPU
# Product                     : TASDF_DASHBOARD=0, TASDF_PUBLISH=127.0.0.1:9090, and OL_TOKEN set in tasdf.env
