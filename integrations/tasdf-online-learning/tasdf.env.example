# App settings for the tasdf-online container. Copy to ${TASDF_DATA_DIR}/tasdf.env (default .data/tasdf-online/tasdf.env).
# Never committed: holds tokens.
#
# IGNORED if set here (docker-compose.tasdf.yml sets them and wins over this file):
#   LS_URL, STATE_DIR, BASELINE_CKPT, HOLDOUT_NPZ, ANCHOR_NPZ          -> fixed container paths
#   DEVICE, TORCH_THREADS, EPISODE_EPOCHS, HOLDOUT_LIMIT, DASHBOARD_ENABLED -> use TASDF_* in compose.env.example
# The startup log line `settings: {...}` (docker logs) shows the values actually in effect.
#
# Running without Docker (python -m tasdf_online.app)? Use a separate env with host paths; do not reuse this file.

# Token of a user with role Manager in the project (Org Admin is read-only in this fork)
LS_TOKEN=
LS_PROJECT_ID=
# Protects /rollback, /refresh_ls_predictions, /telemetry/live (header X-OL-Token). Required in product.
OL_TOKEN=

# Optional app tuning (defaults in tasdf_online/config.py)
# MIN_QUALITY_LEVEL=2
# REFRESH_NEXT_N=0
# REPLAY_SIZE=4
# LR=1e-4
# EMA_ALPHA=0.65
# LS_TIMEOUT=30
# LOG_LEVEL=INFO
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=300
